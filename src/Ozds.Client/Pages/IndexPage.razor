@namespace Ozds.Client.Pages

@page "/"

@* NOTE: hack to make the translator translate this *@
@* Translate("Dashboard") *@
@attribute [Navigation(
Order = -1000,
Title = "Dashboard",
Icon= Icons.Material.Outlined.Home,
Allows = [
RoleModel.OperatorRepresentative,
RoleModel.LocationRepresentative,
RoleModel.NetworkUserRepresentative
])]
@using Ozds.Business.Analysis
@using Ozds.Business.Models.Abstractions
@using Ozds.Client.Attributes
@using Ozds.Client.Components.Dashboards
@using Ozds.Client.Components.Streaming
@using Ozds.Client.State
@inherits Ozds.Client.Components.Base.OzdsComponentBase

<HeadContent>
  <title>OZDS</title>
</HeadContent>

@{
  var model = Analyzer.Analyze(AnalysisState.AnalysisBases.Value);
  var meters = AnalysisState.AnalysisBases.Value
    .Select(analysis => (IMeter)analysis.Meter)
    .DistinctBy(meter => meter.Id)
    .ToList();
  var measurementLocations = AnalysisState.AnalysisBases.Value
    .Select(analysis => (IMeasurementLocation)analysis.MeasurementLocation)
    .DistinctBy(measurementLocation => measurementLocation.Id)
    .ToList();
}
@if (RepresentativeState.Representative.Role
  is RoleModel.NetworkUserRepresentative)
{
  <NetworkUserRepresentativeDashboard Model="@model"
                                      MeasurementLocations="@measurementLocations"/>
}
@if (RepresentativeState.Representative.Role
  is RoleModel.LocationRepresentative)
{
  <LocationRepresentativeDashboard Model="@model"
                                   MeasurementLocations="@measurementLocations"/>
}
@if (RepresentativeState.Representative.Role
  is RoleModel.OperatorRepresentative)
{
  <OperatorRepresentativeDashboard Model="@model"
                                   MeasurementLocations="@measurementLocations"/>
}

@if (RepresentativeState.Representative.Role
  is RoleModel.OperatorRepresentative
  or RoleModel.LocationRepresentative)
{
  var locations = Analyzer.AnalyzeByLocation(
    AnalysisState.AnalysisBases.Value);

  <Table Class="mt-4" Value="@locations" WithHeading/>
}

@if (RepresentativeState.Representative.Role
  is RoleModel.LocationRepresentative
  or RoleModel.NetworkUserRepresentative)
{
  var networkUsers = Analyzer.AnalyzeByNetworkUser(
    AnalysisState.AnalysisBases.Value);

  <Table Class="mt-4" Value="@networkUsers" WithHeading/>
}

@if (RepresentativeState.Representative.Role
  is RoleModel.NetworkUserRepresentative)
{
  var measurementLocationsAnalysis = Analyzer.AnalyzeByMeasurementLocation(
    AnalysisState.AnalysisBases.Value);

  <Table Class="mt-4" Value="@measurementLocationsAnalysis" WithHeading/>
}

@{
  var invoices = AnalysisState.AnalysisBases.Value
    .SelectMany(analysis => analysis.Invoices)
    .DistinctBy(invoice => invoice.Id)
    .OfType<INetworkUserInvoice>()
    .ToList();
}

<Table Class="mt-4" Value="@invoices" WithHeading/>

@code {

  [CascadingParameter]
  public RepresentativeState RepresentativeState { get; set; } = default!;

  [CascadingParameter]
  public AnalysisState AnalysisState { get; set; } = default!;

  [Inject]
  private Analyzer Analyzer { get; set; } = default!;

}
