@namespace Ozds.Client.Pages

@page "/finances/network-user-invoice/{id?}"
@using MudBlazor
@using Ozds.Business.Models.Composite
@using Ozds.Client.Components.Models
@using Ozds.Client.Components.Streaming
@inherits Ozds.Client.Components.Models.Base.OzdsIdentifiableModelPageComponentBase<Ozds.Business.Models.Abstractions.INetworkUserInvoice>

<Mutating
  T="StatefulNetworkUserInvoiceModel"
  LoadAsync="OnLoadAsync">
  <Edit>
    @if (context.Created)
    {
      <NotFound/>
      return;
    }

    <HeadContent>
      <title>OZDS - @Translate("Invoice"): @context.Model.Invoice.Title</title>
    </HeadContent>

    <Edit Model="@context.Model.Invoice"/>
  </Edit>
  <Details>
    <HeadContent>
      <title>OZDS - @Translate("Invoice"): @context.Model.Invoice.Title</title>
    </HeadContent>

    @if (context.Model.State is not null)
    {
      <Details Model="@context.Model.State"/>
    }

    <Details Model="@context.Model.Invoice"/>

    <MudHidden Breakpoint="Breakpoint.SmAndDown">
      <MudLink Href="@(PageHref<NetworkUserInvoiceDocumentPage>(new { context.Model.Invoice.Id }))">
        @Translate("Invoice")
      </MudLink>
    </MudHidden>

    <MudLink Href="@($"/document/network-user-invoice/{context.Model.Invoice.Id}")">
      @Translate("Invoice (PDF)")
    </MudLink>
    <br/>

    @{
      var invoicePreviewHref =
        PageHref<NetworkUserInvoiceDocumentPage>(
          new
          {
            Id = context.Model.Invoice.Id
          });
    }
    <MudLink Class="mt-4" Href="@invoicePreviewHref">
      @Translate("Invoice document")
    </MudLink>
  </Details>
</Mutating>

@code {

  [Parameter]
  public string Id { get; set; } = default!;

}
