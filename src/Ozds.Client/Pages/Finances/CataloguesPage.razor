@namespace Ozds.Client.Pages

@page "/finances/catalogues"

@attribute [Navigation(
Order = 1000,
Title = "Catalogues",
Icon = Icons.Material.Filled.AddBusiness,
Parent = typeof(FinancesPage),
Allows = [
RoleModel.OperatorRepresentative,
])]
@using MudBlazor
@using Ozds.Business.Models.Abstractions
@using Ozds.Client.Attributes
@using Ozds.Client.Components.Streaming
@using Ozds.Client.State
@inherits Ozds.Client.Components.Base.OzdsComponentBase

@if (RepresentativeState.Representative.Role
  is not RoleModel.OperatorRepresentative)
{
  <NotFound/>
  return;
}

<HeadContent>
  <title>OZDS - @Translate("Catalogues")</title>
</HeadContent>

<MudCheckBox
  Label="@Translate("Show deleted")"
  @bind-Value="_deleted"/>

<Table
  Class="mt-4"
  T="INetworkUserCatalogue"
  Deleted="@_deleted"/>

<MudButton
  Class="mt-4"
  Color="Color.Primary"
  Variant="Variant.Outlined"
  Href="@(PageHref<NetworkUserCataloguePage>())">
  @Translate("Create") @Translate(typeof(INetworkUserCatalogue))
</MudButton>

<Table
  Class="mt-8"
  T="IRegulatoryCatalogue"
  Deleted="@_deleted"/>

<MudButton
  Class="mt-4"
  Color="Color.Primary"
  Variant="Variant.Outlined"
  Href="@(PageHref<RegulatoryCataloguePage>())">
  @Translate("Create") @Translate(typeof(IRegulatoryCatalogue))
</MudButton>

@code {
  private bool _deleted;

  [CascadingParameter]
  private RepresentativeState RepresentativeState { get; set; } = default!;

}
