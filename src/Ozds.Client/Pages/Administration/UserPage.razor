@namespace Ozds.Client.Pages

@page "/administration/user/{id?}"
@using Microsoft.AspNetCore.Components.Forms
@using MudBlazor
@using Ozds.Business.Models
@using Ozds.Business.Models.Composite
@using Ozds.Business.Models.Joins
@using Ozds.Business.Reflection
@using Ozds.Client.Components.Models
@using Ozds.Client.Components.Streaming
@inherits Ozds.Client.Components.Models.Base.OzdsIdentifiableModelPageComponentBase<Ozds.Business.Models.RepresentativeModel>

@inject ModelReflector ModelReflector

<MappedMutating
  T="MaybeRepresentingUserModel"
  TMapped="UserModel"
  LoadAsync="OnUserLoadAsync"
  UpdateAsync="OnUserUpdateAsync"
  DeleteAsync="OnUserDeleteAsync"
  CreateAsync="OnUserCreateAsync"
  Map="@(model => model.User)"
  WithHeading
  WithTitle
  WithPreview>
  <Details>
    <Details Model="@context.Model.User"/>

    @if (context.Model.Representative is { } representative)
    {
      <Details Model="@representative"/>
    }
  </Details>
  <Edit>
    <PrefixedEdit Model="@context.Model" Prefix="@(x => x.User)"/>

    <Edit Model="@password" />

    <PrefixedEdit Model="@context.Model" Prefix="@(x => x.Representative)"/>
  </Edit>
  <Footer>
    @if (!context.Created)
    {
      @if (password is not null)
      {
        <MudText Class="my-4" Typo="Typo.h5">
          @Translate("Change password")
        </MudText>

        <EditForm
          Model="@password"
          OnValidSubmit="OnPasswordUpdateAsync"
          Context="editContext">
          <DataAnnotationsValidator/>

          <Edit Model="@password"/>

          <MudText Color="Color.Error" Class="ml-4">
            <ValidationSummary/>
          </MudText>

          <MudButton
            Variant="Variant.Filled"
            Color="Color.Success"
            Class="mt-4"
            ButtonType="ButtonType.Submit">
            @Translate("Update password")
          </MudButton>
        </EditForm>
      }

      <Table
        Class="mt-4"
        PageAsync="OnLocationsPageAsync"/>

      @if (RepresentativeState.Representative.Role
        == RoleModel.OperatorRepresentative)
      {
        <Mutating
          T="LocationRepresentativeModel"
          JoinActivationSide="@typeof(RepresentativeModel)"
          JoinActivationId="@Id"
          Reload
          Class="mt-4"/>
      }

      <Table
        Class="mt-4"
        PageAsync="OnNetworkUsersPageAsync"/>

      @if (RepresentativeState.Representative.Role
        == RoleModel.OperatorRepresentative)
      {
        <Mutating
          T="NetworkUserRepresentativeModel"
          JoinActivationSide="@typeof(RepresentativeModel)"
          JoinActivationId="@Id"
          Reload
          Class="mt-4"/>
      }

      <Table
        PageAsync="OnApiKeysPageAsync"
        Class="mt-4"/>

      @if (RepresentativeState.Representative.Role
        == RoleModel.OperatorRepresentative)
      {
        <MudButton
          Class="mt-4"
          Variant="Variant.Outlined"
          Color="Color.Primary"
          Href="@(PageHref<ApiKeyPage>(queryParameters: new Dictionary<string, object?> { { nameof(ApiKeyPage.PrincipalModelType), ModelReflector.ResolveModelName(typeof(RepresentativeModel)) }, { nameof(ApiKeyPage.PrincipalModelId), Id } }))">
          @Translate("Create") @Translate(typeof(ApiKeyModel))
        </MudButton>
      }
    }
  </Footer>
</MappedMutating>
