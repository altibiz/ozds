@namespace Ozds.Client.Pages

@page "/administration/location/{id?}"
@using MudBlazor
@using Ozds.Business.Models
@using Ozds.Client.Components.Fields
@using Ozds.Client.Components.Models
@using Ozds.Client.Components.Streaming
@inherits Ozds.Client.Components.Models.Base.OzdsIdentifiableModelPageComponentBase<Ozds.Business.Models.LocationModel>

@if (RepresentativeState.Representative.Role
  is not RoleModel.OperatorRepresentative
  and not RoleModel.LocationRepresentative)
{
  <NotFound/>
  return;
}

<Mutating
  T="LocationModel"
  LoadAsync="OnLoadAsync"
  WithTitle
  WithHeading
  WithPreview
  AsReadonly>
  <Details>
    <Details Model="@context.Model"/>

    <div class="mt-8">
      <MudText Typo="Typo.h5">
        @Translate("Report")
      </MudText>

      <div style="width: 170px;">
        <MonthPickerField @bind-Value="@selectedMonth" Label="@Translate("Pick month")"/>
      </div>

      @{
        var energyCardHref =
          "/app/report/location-energy-card"
          + "/" + GetCultureString()
          + "/" + context.Model.Id
          + "/" + selectedMonth.Year
          + "/" + selectedMonth.Month;
        var shortenedEnergyCardHref =
          "/app/report/shortened-location-energy-card"
          + "/" + GetCultureString()
          + "/" + context.Model.Id
          + "/" + selectedMonth.Year
          + "/" + selectedMonth.Month;
      }
      <MudButton
        Class="mt-4"
        Variant="Variant.Outlined"
        Color="Color.Primary"
        Href="@energyCardHref">
        @Translate("Energy card report (CSV)")
      </MudButton>
      <MudButton
        Class="ml-4 mt-4"
        Variant="Variant.Outlined"
        Color="Color.Primary"
        Href="@shortenedEnergyCardHref">
        @Translate("Shortened energy card report (CSV)")
      </MudButton>
    </div>
  </Details>
</Mutating>
