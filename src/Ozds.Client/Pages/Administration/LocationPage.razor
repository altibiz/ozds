@namespace Ozds.Client.Pages

@page "/administration/location/{id?}"
@using Microsoft.AspNetCore.Components.Web
@using MudBlazor
@using Ozds.Business.Models
@using Ozds.Client.Components.Fields
@using Ozds.Client.Components.Models
@using Ozds.Client.Components.Streaming
@inherits Ozds.Client.Components.Models.Base.OzdsIdentifiableModelPageComponentBase<Ozds.Business.Models.LocationModel>

 @if (RepresentativeState.Representative.Role
  is not RoleModel.OperatorRepresentative
  and not RoleModel.LocationRepresentative)
{
  <NotFound/>
  return;
}

<Mutating T="LocationModel" LoadAsync="OnLoadAsync">
  <Label>
    @if (context.Created
      && RepresentativeState.Representative.Role
        is RoleModel.LocationRepresentative)
    {
      <NotFound/>
      return;
    }

    <HeadContent>
      @if (context.Created)
      {
        <title>OZDS - @Translate("New location")</title>
      }
      else
      {
        <title>OZDS - @Translate("Location"): @context.Model.Title</title>
      }
    </HeadContent>
  </Label>
  <Edit>
    @if (context.Created
      && RepresentativeState.Representative.Role
        is RoleModel.LocationRepresentative)
    {
      return;
    }

    <Edit Model="@context.Model"/>
  </Edit>
  <Details>
    @if (context.Created
      && RepresentativeState.Representative.Role
        is RoleModel.LocationRepresentative)
    {
      return;
    }

    <Details Model="@context.Model"/>
  </Details>
</Mutating>
<MudGrid Justify="Justify.FlexStart" Spacing="2" Style="width: 170px">
  <MudItem>
    <MudDatePicker Label="@Translate("Pick month")"
                   Date="selectedMonth"
                   DateChanged="OnDateChanged"
                   OpenTo="OpenTo.Month"
                   FixDay="@DateTime.Today.Day"
                   DateFormat="MM.yyyy."/>
  </MudItem>
  <MudItem>
    <DownloadField IsGeneric="false" FileName="@(Id + "_MonthlyAggregate_" + selectedMonth?.ToString("MM.yyyy") + ".csv")" Models="@measurements"/>
  </MudItem>
</MudGrid>
