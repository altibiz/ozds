@namespace Ozds.Client.Pages

@page "/administration/network-users"

@attribute [Navigation(
Order = 2,
Title = "Network users",
Icon = Icons.Material.Filled.VerifiedUser,
Parent = typeof(AdministrationPage),
Allows = [
RoleModel.OperatorRepresentative,
RoleModel.LocationRepresentative,
RoleModel.NetworkUserRepresentative
])]
@using Microsoft.AspNetCore.Components.Web
@using MudBlazor
@using Ozds.Business.Analysis
@using Ozds.Business.Models
@using Ozds.Business.Queries
@using Ozds.Business.Queries.Abstractions
@using Ozds.Client.Attributes
@using Ozds.Client.Components.Fields
@using Ozds.Client.Components.Models
@using Ozds.Client.Components.Streaming
@using Ozds.Client.Records
@using Ozds.Client.State
@inherits Ozds.Client.Components.Base.OzdsComponentBase

<HeadContent>
  <title>OZDS - @Translate("Network users")</title>
</HeadContent>

@{
  var analyses = AnalysisState.AnalysisBases.Value
    .AnalysesByNetworkUser();
}

@if (RepresentativeState.Representative.Role
  == RoleModel.OperatorRepresentative)
{
  <MudCheckBox
    Label="@Translate("Deleted")"
    @bind-Value="_deleted"/>
}

@if (_deleted)
{
  <Paging T="NetworkUserModel" Deleted="@_deleted"/>
}
else
{

  <Table Model="@analyses"/>

}

@if (RepresentativeState.Representative.Role
  == RoleModel.OperatorRepresentative)
{
  <Table PageAsync="OnPageAsync" Model="networkUsers" />
  <MudLink Href="@(PageHref<NetworkUserPage>())">
    @Translate("Create")
  </MudLink>
  <DownloadField IsGeneric="@false" FileName="NetworkUsersExport.csv" Models="@analyses.Select(x => x.NetworkUser).ToList()"></DownloadField>
  <UploadTabs TRecord="NetworkUserRecord"></UploadTabs>
}

@code {

  [CascadingParameter]
  public AnalysisState AnalysisState { get; set; } = default!;

  [CascadingParameter]
  private RepresentativeState RepresentativeState { get; set; } = default!;

  private bool _deleted;

  List<NetworkUserModel> networkUsers = new();

  protected override async Task OnInitializedAsync()
  {
    await OnPageAsync(0);
  }

  private async Task<PaginatedList<NetworkUserModel>> OnPageAsync(
    int page
  )
  {
    var queries = ScopedServices.GetRequiredService<NetworkUserQueries>();

    var netUsers =
      await queries.ReadNetworkUsersByRepresentativeId(
      RepresentativeState.Representative.Id,
      RepresentativeState.Representative.Role,
      page,
      CancellationToken
      );
    var a = netUsers.TotalCount;
    networkUsers = netUsers.Items;
    return netUsers;
  }
}
