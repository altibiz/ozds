@namespace Ozds.Client.Pages

@page "/administration/network-user/{id?}"
@using Microsoft.AspNetCore.Components.Web
@using MudBlazor
@using Ozds.Business.Models
@using Ozds.Client.Components.Models
@using Ozds.Client.Components.Streaming
@inherits Ozds.Client.Components.Models.Base.OzdsIdentifiableModelPageComponentBase<Ozds.Business.Models.NetworkUserModel>

<Mutating T="NetworkUserModel" LoadAsync="OnLoadAsync">
  <Label>
    <HeadContent>
      @if (context.Created)
      {
        <title>OZDS - @Translate("New network user")</title>
      }
      else
      {
        <title>OZDS - @Translate("Network user"): @context.Model.Title</title>
      }
    </HeadContent>
  </Label>
  <Edit>
    <Edit Model="@context.Model"/>
  </Edit>
  <Details>
    <Details Model="@context.Model"/>

    <div>
      <MudText Typo="Typo.body1">
        @Translate("Preview invoice")
      </MudText>

      <MudNumericField
        Label="@Translate("Year")"
        @bind-Value="@previewInvoiceYear"
        Min="2000"
        Max="@DateTimeOffset.UtcNow.Year"
        Step="1"/>
      <MudNumericField
        Label="@Translate("Month")"
        @bind-Value="@previewInvoiceMonth"
        Min="1"
        Max="12"
        Step="1"/>

      <MudHidden Breakpoint="Breakpoint.SmAndDown">
        <MudLink Href="@(PageHref<NetworkUserInvoicePreviewDocumentPage>(new { NetworkUserId = context.Model.Id, Year = previewInvoiceYear, Month = previewInvoiceMonth }))">
          @Translate("Document")
        </MudLink>
      </MudHidden>

      <MudLink Href="@("/download/network-user-invoice-preview/" + context.Model.Id + "/" + previewInvoiceYear + "/" + previewInvoiceMonth)">
        @Translate("Pdf")
      </MudLink>
    </div>
  </Details>
</Mutating>
<MudGrid Justify="Justify.FlexStart" Spacing="2" Style="width: 170px">
  <MudItem>
    <MudDatePicker Label="@Translate("Pick month")"
                   Date="selectedMonth"
                   DateChanged="OnDateChanged"
                   OpenTo="OpenTo.Month"
                   FixDay="@DateTime.Today.Day"
                   DateFormat="MM.yyyy."/>
  </MudItem>
  @if (selectedMonth is not null)
  {
    <MudLink Href="@("/download/csv-export-network-user-monthly-aggregate/" + string.Join(',', analysis.Select(x => x!.MeasurementLocation.Id).ToList()) + "/" + selectedMonth.Value.ToString("yyyy-MM-dd"))">
      @Translate("Csv")

    </MudLink>
  }
</MudGrid>

@code {
  private int previewInvoiceYear = DateTimeOffset.UtcNow.Year;
  private int previewInvoiceMonth = DateTimeOffset.UtcNow.Month;
}
