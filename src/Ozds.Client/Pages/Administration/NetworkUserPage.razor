@namespace Ozds.Client.Pages

@page "/administration/network-user/{id?}"
@using Microsoft.AspNetCore.Components.Web
@using MudBlazor
@using Ozds.Business.Models
@using Ozds.Client.Components.Fields
@using Ozds.Client.Components.Models
@using Ozds.Client.Components.Streaming
@inherits Ozds.Client.Components.Models.Base.OzdsIdentifiableModelPageComponentBase<Ozds.Business.Models.NetworkUserModel>

<Mutating T="NetworkUserModel" LoadAsync="OnLoadAsync">
  <Label>
    <HeadContent>
      @if (context.Created)
      {
        <title>OZDS - @Translate("New network user")</title>
      }
      else
      {
        <title>OZDS - @Translate("Network user"): @context.Model.Title</title>
      }
    </HeadContent>
  </Label>
  <Edit>
    <Edit Model="@context.Model"/>
  </Edit>
  <Details>
    <Details Model="@context.Model"/>

    <div>
      <MudText Typo="Typo.body1">
        @Translate("Preview invoice")
      </MudText>

      <MudHidden Breakpoint="Breakpoint.SmAndDown">
        <div style="margin-top: 10px; margin-bottom: 10px;">
          <MudLink
            Class="mud-button mud-button-filled mud-primary p-2 rounded-lg"
            Style="color: white !important;"
            Href="@(PageHref<NetworkUserInvoicePreviewDocumentPage>(new { NetworkUserId = context.Model.Id, Year = previewInvoiceYear, Month = previewInvoiceMonth }))">
            @Translate("Document")
          </MudLink>
        </div>
      </MudHidden>

      <div style="width: 170px;">
        <MonthPickerField @bind-Value="@invoiceSelectedMonth" Label="@Translate("Pick month")"/>
      </div>

      @if (invoiceSelectedMonth is not null)
      {
        <div style="margin-top: 10px;">
          <MudLink
            Class="mud-button mud-button-filled mud-primary p-2 rounded-lg"
            Style="color: white !important;"
            Href="@("/download/network-user-invoice-preview/" + context.Model.Id + "/" + invoiceSelectedMonth.Value.Year + "/" + invoiceSelectedMonth.Value.Month)">
            @Translate("Pdf")
          </MudLink>
        </div>
      }
    </div>

    <div style="width: 170px;">
      <MonthPickerField @bind-Value="@selectedMonth" Label="@Translate("Pick month")"/>
      <div style="margin-top: 10px;">
        @if (selectedMonth is not null)
        {
          <MudLink
            Class="mud-button mud-button-filled mud-primary p-2 rounded-lg"
            Style="color: white !important;"
            Href="@("/download/network-user-monthly-aggregates/" + context.Model.Id + "/" + selectedMonth.Value.Year + "/" + selectedMonth.Value.Month)">
            @Translate("Csv")
          </MudLink>
        }
      </div>
    </div>
  </Details>
</Mutating>
