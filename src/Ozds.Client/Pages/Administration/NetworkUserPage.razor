@namespace Ozds.Client.Pages

@page "/administration/network-user/{id?}"
@using MudBlazor
@using Ozds.Business.Models
@using Ozds.Client.Components.Fields
@using Ozds.Client.Components.Models
@using Ozds.Client.Components.Streaming
@inherits Ozds.Client.Components.Models.Base.OzdsIdentifiableModelPageComponentBase<Ozds.Business.Models.NetworkUserModel>

<Mutating T="NetworkUserModel" LoadAsync="OnLoadAsync">
  <Label>
    <HeadContent>
      @if (context.Created)
      {
        <title>OZDS - @Translate("New network user")</title>
      }
      else
      {
        <title>OZDS - @Translate("Network user"): @context.Model.Title</title>
      }
    </HeadContent>
  </Label>
  <Edit>
    <Edit Model="@context.Model"/>
  </Edit>
  <Details>
    <Details Model="@context.Model"/>

    <div>
      <MudText Typo="Typo.body1">
        @Translate("Preview invoice")
      </MudText>


      <div style="width: 170px;">
        <MonthPickerField
          @bind-Value="@invoiceSelectedMonth"
          Label="@Translate("Pick month")"/>
      </div>
      <br/>

      <MudHidden Breakpoint="Breakpoint.SmAndDown">
        @{
          var invoicePreviewHref =
            PageHref<NetworkUserInvoicePreviewDocumentPage>(
              new
              {
                NetworkUserId = context.Model.Id,
                invoiceSelectedMonth.Year,
                invoiceSelectedMonth.Month
              });
        }
        <br/>
        <MudLink Class="mt-4" Href="@invoicePreviewHref">
          @Translate("Preview invoice document")
        </MudLink>
        <br/>
      </MudHidden>
      @{
        var invoicePreviewPdfHref =
          "/document/network-user-invoice-preview"
          + "/" + context.Model.Id
          + "/" + invoiceSelectedMonth.Year
          + "/" + invoiceSelectedMonth.Month;
      }
    </div>
    <MudLink Class="mt-4" Href="@invoicePreviewPdfHref">
      @Translate("Preview invoice pdf")
    </MudLink>
    <br/>
    <MudButton OnClick="OnCreateInvoiceAsync">
      @Translate("Create invoice")
    </MudButton>

    <div style="width: 170px;">
      <MonthPickerField
        @bind-Value="@monthlyAggregatesSelectedMonth"
        Label="@Translate("Pick month")"/>
      @{
        var energyCardHref =
          "/report/network-user-energy-card"
          + "/" + GetCulture().TwoLetterISOLanguageName
          + "/" + context.Model.Id
          + "/" + monthlyAggregatesSelectedMonth.Year
          + "/" + monthlyAggregatesSelectedMonth.Month;
      }
      <MudLink Href="@energyCardHref" Class="mt-4">
        @Translate("Energy card CSV")
      </MudLink>
    </div>
  </Details>
</Mutating>
