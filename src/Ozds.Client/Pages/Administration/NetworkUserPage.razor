@namespace Ozds.Client.Pages

@page "/administration/network-user/{id?}"
@using Microsoft.AspNetCore.Components.Web
@using MudBlazor
@using Ozds.Business.Models
@using Ozds.Client.Components.Fields
@using Ozds.Client.Components.Models
@using Ozds.Client.Components.Streaming
@inherits Ozds.Client.Components.Models.Base.OzdsIdentifiableModelPageComponentBase<Ozds.Business.Models.NetworkUserModel>

<Mutating T="NetworkUserModel" LoadAsync="OnLoadAsync">
  <Label>
    <HeadContent>
      @if (context.Created)
      {
        <title>OZDS - @Translate("New network user")</title>
      }
      else
      {
        <title>OZDS - @Translate("Network user"): @context.Model.Title</title>
      }
    </HeadContent>
  </Label>
  <Edit>
    <Edit Model="@context.Model"/>
  </Edit>
  <Details>
    <Details Model="@context.Model"/>
  </Details>
</Mutating>
  <MudGrid Justify="Justify.FlexStart" AlignItems="Center" Spacing="2" Style="width: 170px">
    <MudItem xs="12">
      <MudDatePicker Label="@Translate("Pick month")"
                     Date="selectedMonth"
                     DateChanged="OnDateChanged"
                     OpenTo="OpenTo.Month"
                     FixDay="@DateTime.Today.Day"
                     DateFormat="MM.yyyy."
                     Dense="true" />
    </MudItem>
    <MudItem xs="12">
      <DownloadField IsGeneric="false" FileName="@(Id + "_MonthlyAggregate_" + selectedMonth?.ToString("MM.yyyy") + ".csv")" Models="@measurements" />
    </MudItem>
  </MudGrid>
