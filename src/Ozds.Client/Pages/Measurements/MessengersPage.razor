@namespace Ozds.Client.Pages

@page "/measurements/messengers"

@attribute [Navigation(
Order = 10,
Title = "Messengers",
Icon = Icons.Material.Filled.Router,
Parent = typeof(MeasurementsPage),
Allows = [RoleModel.OperatorRepresentative])]
@using MudBlazor
@using Ozds.Business.Models.Abstractions
@using Ozds.Client.Attributes
@using Ozds.Client.Components.Streaming
@using Ozds.Client.State
@inherits Ozds.Client.Components.Base.OzdsComponentBase

@if (RepresentativeState.Representative.Role
  is not RoleModel.OperatorRepresentative)
{
  <NotFound/>
  return;
}

<HeadContent>
  <title>OZDS - @Translate("Messengers")</title>
</HeadContent>

<MudCheckBox
  Label="@Translate("Show deleted")"
  @bind-Value="_deleted"/>

<Table T="IMessenger" Deleted="@_deleted"/>

@if (RepresentativeState.Representative.Role
  == RoleModel.OperatorRepresentative)
{
  <MudButton
    Class="mt-4"
    Variant="Variant.Outlined"
    Color="Color.Primary"
    Href="@(PageHref<MessengerPage>())">
    @Translate("Create") @Translate(typeof(IMessenger))
  </MudButton>
}

@code {

  [CascadingParameter]
  private RepresentativeState RepresentativeState { get; set; } = default!;

  private bool _deleted;
}
