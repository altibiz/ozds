@namespace Ozds.Client.Pages

@page "/measurements/meter/{id?}"
@using Microsoft.AspNetCore.Components.Web
@using MudBlazor
@using Ozds.Business.Analysis
@using Ozds.Business.Models.Abstractions
@using Ozds.Business.Models.Enums
@using Ozds.Business.Queries
@using Ozds.Business.Time
@using Ozds.Client.Components.Charts
@using Ozds.Client.Components.Fields
@using Ozds.Client.Components.Models
@using Ozds.Client.Components.Streaming
@using Ozds.Client.State
@inherits Ozds.Client.Components.Models.Base.OzdsIdentifiableModelPageComponentBase<Ozds.Business.Models.Abstractions.IMeter>

@if (RepresentativeState.Representative.Role is not RoleModel.OperatorRepresentative)
{
  <NotFound/>
  return;
}

@if (analysis is not null)
{
  <Table Model="@analysis.Analysis.Monthly">
    <Summary>
      <Summary Model="@context"/>
    </Summary>
    <Details>
      <Details Model="@context"/>
    </Details>
    <Columns>
      <Columns Models="@analysis.Analysis.Monthly"/>
    </Columns>
  </Table>
    <MudGrid Justify="Justify.FlexStart" Spacing="2" Style="width: 170px">
    <MudItem xs="12">
      <MudDatePicker Label="@Translate("Pick month")"
                     Date="selectedMonth"
                     DateChanged="OnDateChanged"
                     OpenTo="OpenTo.Month"
                     FixDay="@DateTime.Today.Day"
                     DateFormat="MM.yyyy." />
    </MudItem>
    <MudItem xs="12">
      <DownloadField FileName="@("Meter_" + Id + "_Measurements_" + selectedMonth?.ToString("MM.yyyy") + ".csv")" Models="@measurements" />
    </MudItem>
  </MudGrid>
  <MeasurementChartControls Meters="@meters">
    <MeasurementGaugeChart Parameters="@context"/>
    <MeasurementLineChart Parameters="@context" Brush="@(Breakpoint >= Breakpoint.MdAndUp)"/>
  </MeasurementChartControls>
}

<Mutating T="IMeter" Value="@(analysis?.Meter)" Id="@Id">
  <Edit>
    <HeadContent>
      @if (context.Created)
      {
        <title>OZDS - @Translate("New meter")</title>
      }
      else
      {
        <title>OZDS - @Translate("Meter"): @context.Model.Title</title>
      }
    </HeadContent>
    <Edit Model="context.Model"/>
  </Edit>
  <Details>
    <HeadContent>
      <title>OZDS - @Translate("Meter"): @context.Model.Title</title>
    </HeadContent>
    <Details Model="context.Model"/>
  </Details>
</Mutating>
