@namespace Ozds.Client.Pages

@page "/measurements/messenger/{id?}"
@using MudBlazor
@using Ozds.Business.Models
@using Ozds.Business.Models.Abstractions
@using Ozds.Business.Reflection
@using Ozds.Client.Components.Streaming
@inherits Ozds.Client.Components.Models.Base.OzdsIdentifiableModelPageComponentBase<Ozds.Business.Models.Abstractions.IMessenger>

@inject ModelReflector ModelReflector

@if (RepresentativeState.Representative.Role
  is not RoleModel.OperatorRepresentative)
{
  <NotFound/>
  return;
}

<Mutating T="IMessenger" Id="@Id" WithTitle WithHeading WithPreview/>

<Table PageAsync="OnApiKeysPageAsync" WithHeading Class="mt-4"/>

@if (RepresentativeState.Representative.Role
  == RoleModel.OperatorRepresentative)
{
  <MudButton
    Class="mt-4"
    Variant="Variant.Outlined"
    Color="Color.Primary"
    Href="@(PageHref<ApiKeyPage>(queryParameters: new Dictionary<string, object?> { { nameof(ApiKeyPage.PrincipalModelType), ModelReflector.ResolveModelName(typeof(IMessenger)) }, { nameof(ApiKeyPage.PrincipalModelId), Id } }))">
    @Translate("Create") @Translate(typeof(ApiKeyModel))
  </MudButton>
}
