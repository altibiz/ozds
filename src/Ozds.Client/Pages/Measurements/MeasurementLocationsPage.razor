@namespace Ozds.Client.Pages

@page "/measurements/measurement-locations"

@attribute [Navigation(
Order = 0,
Title = "Measurement locations",
Icon = Icons.Material.Filled.ElectricMeter,
Parent = typeof(MeasurementsPage),
Allows = [
RoleModel.OperatorRepresentative,
RoleModel.LocationRepresentative,
RoleModel.NetworkUserRepresentative
])]
@using MudBlazor
@using Ozds.Business.Analysis
@using Ozds.Business.Models.Abstractions
@using Ozds.Client.Attributes
@using Ozds.Client.Components.Fields
@using Ozds.Client.Components.Streaming
@using Ozds.Client.State
@inherits Ozds.Client.Components.Base.OzdsComponentBase

<HeadContent>
  <title>OZDS - @Translate("Measurement locations")</title>
</HeadContent>

@{
  var analyses = Analyzer.AnalyzeByMeasurementLocation(
    AnalysisState.AnalysisBases.Value);
}

@if (RepresentativeState.Representative.Role
  == RoleModel.OperatorRepresentative)
{
  <MudCheckBox
    Label="@Translate("Show deleted")"
    @bind-Value="_deleted"/>
}

<Table
  Model="@(analyses
    .Where(x => x.MeasurementLocation.IsDeleted == _deleted)
    .ToList())"/>

@if (RepresentativeState.Representative.Role
  == RoleModel.OperatorRepresentative)
{
  <MudButton
    Class="mt-4"
    Variant="Variant.Outlined"
    Color="Color.Primary"
    Href="@(PageHref<MeasurementLocationPage>())">
    @Translate("Create") @Translate(typeof(IMeasurementLocation))
  </MudButton>
  <UploadTabs
    Class="mt-8"
    T="IMeasurementLocation"/>
}

@code {

  [CascadingParameter]
  public AnalysisState AnalysisState { get; set; } = default!;

  [CascadingParameter]
  private RepresentativeState RepresentativeState { get; set; } = default!;

  [Inject]
  private Analyzer Analyzer { get; set; } = default!;

  private bool _deleted;
}
