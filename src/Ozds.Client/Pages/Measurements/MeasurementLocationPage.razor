@namespace Ozds.Client.Pages

@page "/measurements/measurement-location/{id?}"
@using Microsoft.AspNetCore.Components.Web
@using MudBlazor
@using Ozds.Business.Analysis
@using Ozds.Business.Models.Abstractions
@using Ozds.Client.Components.Charts
@using Ozds.Client.Components.Models
@using Ozds.Client.Components.Streaming
@using Ozds.Client.State
@inherits Ozds.Client.Components.Models.Base.OzdsIdentifiableModelPageComponentBase<IMeasurementLocation>

@{
  var analysis = AnalysisState
    .AnalysisBases.Value.AnalysesByMeasurementLocation()
    .FirstOrDefault(x => x.MeasurementLocation.Id == Id);
}

@if (analysis is not null)
{
  <Table Model="@analysis.Analysis.Monthly">
    <Summary>
      <Summary Model="@context"/>
    </Summary>
    <Details>
      <Details Model="@context"/>
    </Details>
    <Columns>
      <Columns Models="@analysis.Analysis.Monthly"/>
    </Columns>
  </Table>

  <div style="width: 170px;">
    <MonthPickerField @bind-Value="selectedMonth" Label="@Translate("Pick month")" />
    <div style="margin-top: 10px;">
      @if (selectedMonth is not null)
      {
        <MudLink
          Class="mud-button mud-button-filled mud-primary p-2 rounded-lg"
          Style="color: white !important;"
          Href="@("/download/measurement-location-quarter-hourly-aggregates-for-month/" + Id + "/" + selectedMonth.Value.Year + "/" + selectedMonth.Value.Month)">
            @Translate("Csv")
        </MudLink>
      }
    </div>
  </div>

  measurementLocations = new List<IMeasurementLocation>
  {
    analysis.MeasurementLocation
  };


  <MeasurementChartControls MeasurementLocations="@measurementLocations">
    <MeasurementGaugeChart
      Parameters="@context"/>
    <MeasurementLineChart
      Parameters="@context"
      Brush="@(Breakpoint >= Breakpoint.MdAndUp)"/>
  </MeasurementChartControls>
}

<Mutating T="IMeasurementLocation" Id="@Id">
  <Edit>
    <HeadContent>
      @if (context.Created)
      {
        <title>OZDS - @Translate("New measurement location")</title>
      }
      else
      {
        <title>
          OZDS - @Translate("Measurement location"): @context.Model.Title
        </title>
      }
    </HeadContent>

    <Edit Model="context.Model"/>
  </Edit>
  <Details>
    <HeadContent>
      <title>
        OZDS - @Translate("Measurement location"): @context.Model.Title
      </title>
    </HeadContent>

    <Details Model="context.Model"/>
  </Details>
</Mutating>

@code{
  private DateTime? selectedMonth;

  [CascadingParameter]
  public AnalysisState AnalysisState { get; set; } = default!;

  [CascadingParameter]
  public Breakpoint Breakpoint { get; set; }

  [Parameter]
  public string Id { get; set; } = default!;

  private List<IMeasurementLocation> measurementLocations = new();
}
