@namespace Ozds.Client.Pages

@page "/measurements/measurement-location/{id?}"
@using MudBlazor
@using Ozds.Business.Models.Abstractions
@using Ozds.Business.Models.Enums
@using Ozds.Client.Components.Charts
@using Ozds.Client.Components.Fields
@using Ozds.Client.Components.Models
@using Ozds.Client.Components.Streaming
@inherits Ozds.Client.Components.Models.Base.OzdsIdentifiableModelPageComponentBase<Ozds.Business.Models.Abstractions.IMeasurementLocation>

@{
  var analysis = Analyzer
    .AnalyzeByMeasurementLocation(AnalysisState.AnalysisBases.Value)
    .FirstOrDefault(x => x.MeasurementLocation.Id == Id);
}

@if (analysis is not null)
{
  <Table Model="@analysis.Analysis.Monthly">
    <Summary>
      <Summary Model="@context"/>
    </Summary>
    <Details>
      <Details Model="@context"/>
    </Details>
    <Columns>
      <Columns Models="@analysis.Analysis.Monthly"/>
    </Columns>
  </Table>

  <div style="width: 170px;">
    <MonthPickerField
      @bind-Value="@selectedMonth"
      Label="@Translate("Pick month")"/>
    <EnumPicker
      Title="@Translate("Pick OBIS code")"
      @bind-Value="@selectedObis"
      Label="@(x => x.ToCode())"/>
    @{
      var accountingPeriodHref =
        "/report/measurement-location-accounting-period"
        + "/" + GetCulture().TwoLetterISOLanguageName
        + "/" + Id
        + "/" + selectedMonth.Year
        + "/" + selectedMonth.Month;

      var loadCurveHref =
        "/report/measurement-location-load-curve"
        + "/" + GetCulture().TwoLetterISOLanguageName
        + "/" + Id
        + "/" + selectedObis.ToCode()
        + "/" + selectedMonth.Year
        + "/" + selectedMonth.Month;
    }
    <MudLink Class="mt-4" Href="@accountingPeriodHref">
      @Translate("Accounting period CSV")
    </MudLink>
    <MudLink Class="mt-4" Href="@loadCurveHref">
      @Translate("Load curve CSV")
    </MudLink>
  </div>

  <MeasurementChartControls
    MeasurementLocations="@(new List<IMeasurementLocation> { analysis.MeasurementLocation })">
    <MeasurementGaugeChart
      Parameters="@context"/>
    <MeasurementLineChart
      Parameters="@context"/>
  </MeasurementChartControls>
}

<Mutating T="IMeasurementLocation" Id="@Id">
  <Edit>
    <HeadContent>
      @if (context.Created)
      {
        <title>OZDS - @Translate("New measurement location")</title>
      }
      else
      {
        <title>
          OZDS - @Translate("Measurement location"): @context.Model.Title
        </title>
      }
    </HeadContent>

    <Edit Model="context.Model"/>
  </Edit>
  <Details>
    <HeadContent>
      <title>
        OZDS - @Translate("Measurement location"): @context.Model.Title
      </title>
    </HeadContent>

    <Details Model="context.Model"/>
  </Details>
</Mutating>
