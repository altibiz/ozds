@namespace Ozds.Client.Pages

@page "/developer"

@attribute [Navigation(
Order = 1000,
Title = "Developer",
Icon = Icons.Material.Filled.BugReport,
Developer = true,
Allows = [
RoleModel.OperatorRepresentative,
RoleModel.NetworkUserRepresentative,
RoleModel.LocationRepresentative,
])]
@using MudBlazor
@using Ozds.Client.Attributes
@using Ozds.Client.Components.Streaming
@inherits Ozds.Client.Components.Base.OzdsComponentBase

<HeadContent>
  <title>OZDS - @Translate("Developer")</title>
</HeadContent>

@if (!Environment.IsDevelopment())
{
  <RedirectToIndex/>
  return;
}

<p>
  <MudText Class="mb-4" Typo="Typo.h5">
    @Translate("Server controls")
  </MudText>

  <MudButton
    Color="Color.Error"
    Variant="Variant.Filled"
    OnClick="OnThrowClick">
    @Translate("Throw exception")
  </MudButton>

  <MudButton
    Color="Color.Error"
    Variant="Variant.Filled"
    Class="ml-4"
    OnClick="OnStopClick">
    @Translate("Stop app")
  </MudButton>
</p>

<p class="mt-8">
  <MudText Class="mb-4" Typo="Typo.h5">
    @Translate("Document controls")
  </MudText>

  <MudButton
    Color="Color.Success"
    Variant="Variant.Filled"
    OnClick="OnPdfClick">
    @Translate("Generate PDF")
  </MudButton>
</p>
