@namespace Ozds.Client.Pages

@page "/unapproved"
@using MudBlazor
@using Ozds.Client.Components.Streaming
@using Ozds.Client.State
@inherits Ozds.Client.Components.Base.OzdsComponentBase

@if (RepresentativeState?.Representative is not null)
{
  <RedirectToIndex/>
  return;
}

<MudText Typo="Typo.h3">
  @Translate("You are unapproved")
</MudText>

<MudText>
  @Translate("Please wait for an administrator to approve you.")
</MudText>

@code {

  [CascadingParameter]
  public RepresentativeState? RepresentativeState { get; set; }

}
