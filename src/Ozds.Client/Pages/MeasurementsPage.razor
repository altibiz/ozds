@namespace Ozds.Client.Pages

@page "/measurements"

@attribute [Navigation(
Order = 11,
Title = "Measurements",
Icon = Icons.Material.Filled.ElectricBolt,
Allows = [
RoleModel.OperatorRepresentative,
RoleModel.LocationRepresentative,
RoleModel.NetworkUserRepresentative
])]
@using MudBlazor
@using Ozds.Business.Models.Abstractions
@using Ozds.Client.Attributes
@using Ozds.Client.Components.Fields
@using Ozds.Client.Components.Streaming
@inherits Ozds.Client.Components.Base.OzdsComponentBase

<HeadContent>
  <title>OZDS - @Translate("Measurements")</title>
</HeadContent>

@{
  var measurementLocations = Analyzer.AnalyzeByMeasurementLocation(
    AnalysisState.AnalysisBases.Value);
}

<MudButton
  Class="mb-2"
  Variant="Variant.Outlined"
  Color="Color.Primary"
  Href="@ApiV1Href">
  @Translate("API")
</MudButton>

<MappedTable
  Value="measurementLocations"
  Map="@(x => x.MeasurementLocation)"
  WithHeading/>

@if (RepresentativeState.Representative.Role
  != RoleModel.OperatorRepresentative)
{
  return;
}

@{
  var meters = Analyzer.AnalyzeByMeter(
    AnalysisState.AnalysisBases.Value);
}

<Table
  Class="mt-4"
  Value="meters"
  WithHeading/>

<Table
  Class="mt-4"
  PageAsync="OnMessengersPageAsync"
  WithHeading/>

<UploadTabs
  Class="mt-4"
  T="IMeasurement"/>
