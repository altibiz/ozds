@namespace Ozds.Client.Components.Dialogs
@using MudBlazor
@inherits Ozds.Client.Components.Base.OzdsComponentBase

<MudDialog OnBackdropClick="OnExit">
  <DialogContent>
    <MudText Typo="Typo.body1" Style="min-width: 200px;">
      @Body
    </MudText>
  </DialogContent>
  <DialogActions>
    @if (NavigationBehavior == MutatingResultNavigationBehavior.Logout)
    {
      <MudForm method="post" action="@LogoutHref">
        <input
          type="hidden"
          name="__RequestVerificationToken"
          value="@UserState.LogoutToken"/>
        <MudButton
          FullWidth
          Color="Color.Primary"
          OnClick="OnExit"
          ButtonType="ButtonType.Submit">
          @Translate("Close")
        </MudButton>
      </MudForm>
    }
    else
    {
      <MudButton FullWidth Color="Color.Primary" OnClick="OnExit">
        @Translate("Close")
      </MudButton>
    }
  </DialogActions>
</MudDialog>
