@namespace Ozds.Client.Components.Fields
@typeparam T
@using MudBlazor
@using Ozds.Business.Activation
@inherits Ozds.Client.Components.Base.OzdsComponentBase

@{
  var subtypes = ModelActivator
    .ActivatableSubtypes(typeof(T))
    .ToList();
}

<div class="@Class" style="@Style">
  @if (subtypes.Count == 1)
  {
    <UploadField Type="subtypes[0]"/>
  }
  else if (subtypes.Count > 1)
  {
    <MudTabs Elevation="2" Rounded="true" ApplyEffectsToContainer="true" PanelClass="pa-6">
      @foreach (var type in subtypes)
      {
        <MudTabPanel Text="@Translate(type)">
          <UploadField Type="@type"/>
        </MudTabPanel>
      }
    </MudTabs>
  }
</div>

@code {

  [Inject]
  private ModelActivator ModelActivator { get; set; } = default!;

  [Parameter]
  public string Class { get; set; } = default!;

  [Parameter]
  public string Style { get; set; } = default!;

}
