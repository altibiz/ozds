@namespace Ozds.Client.Components.Fields
@inherits Ozds.Client.Components.Base.OzdsComponentBase
@using MudBlazor
@typeparam T

<SelectField
  T="T"
  Label="@Title"
  Value="@Value"
  ValueChanged="@ValueChanged"
  For="For"
  Disabled="@Disabled">
  @foreach (var item in Values)
  {
    var typed = (T)item;

    if (typed is not { } value)
    {
      <MudSelectItem Value="@typed">
        @if (Label is { } label)
        {
          @label(typed)
        }
        else
        {
          @Translate("None")
        }
      </MudSelectItem>

      continue;
    }

    <MudSelectItem Value="@value">
      @if (Label is { } label)
      {
        @label(value)
      }
      else
      {
        @Translate(value.ToString()!)
      }
    </MudSelectItem>
  }
</SelectField>
