-->
<style>
  .mud-expand-panel-text {
    font-size: var(--mud-typography-body1-size);
  }

  .mud-drop-container {
    user-select: text !important;
  }

  .mud-table-cell {
    font-size: var(--mud-typography-body1-size);
  }
</style>
