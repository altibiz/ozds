@namespace Ozds.Client.Components.Providers

@inherits Ozds.Client.Components.Base.DisposableComponentBase

<script>
  window.ozdsGetTimeZone = () =>
    Intl.DateTimeFormat().resolvedOptions().timeZone;
</script>

