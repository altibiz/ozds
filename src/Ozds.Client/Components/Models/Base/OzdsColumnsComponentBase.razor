@namespace Ozds.Client.Components.Models.Base

@typeparam TPrefix
@typeparam TModel
@using System.Collections
@using System.Linq.Expressions
@using MudBlazor
@using Ozds.Business.Models.Abstractions
@using Ozds.Client.Components.Streaming
@using Ozds.Client.Extensions
@inherits OzdsListModelComponentBase<TPrefix, TModel>

@Base()

@code {

  protected RenderFragment Column(Expression<Func<TModel, string?>> next)
  {
    return Nest(
      @<PropertyColumn
         Filterable="false"
         Sortable="false"
         T="TPrefix"
         TProperty="string"
         Title="@(Translate(Label(next)))"
         Property="@Wrap(next)"/>);
  }

  protected RenderFragment Column(Expression<Func<TModel, Enum?>> next)
  {
    var nextFunc = next.Compile();
    return Nest(
      @<PropertyColumn
         Filterable="false"
         Sortable="false"
         T="TPrefix"
         TProperty="Enum"
         Title="@(Translate(Label(next)))"
         Property="@Wrap(next)">
        <CellTemplate>
          <MudText>
            @if (Get(nextFunc)(context.Item) is { } value)
            {
              @Translate(value.ToString())
            }
          </MudText>
        </CellTemplate>
      </PropertyColumn>);
  }

  protected RenderFragment Column(Expression<Func<TModel, decimal?>> next, int decimalPlaces = 2)
  {
    var nextFunc = next.Compile();
    return Nest(
      @<PropertyColumn
         Filterable="false"
         Sortable="false"
         T="TPrefix"
         TProperty="decimal?"
         Title="@(Translate(Label(next)))"
         Property="@Wrap(next)">
        <CellTemplate>
          <MudText>
            @if (Get(nextFunc)(context.Item) is decimal d)
            {
              @NumericString(d, decimalPlaces)
            }
          </MudText>
        </CellTemplate>
      </PropertyColumn>);
  }

  protected RenderFragment Column<T>(
    Expression<Func<TModel, IEnumerable<T>?>> next
  )
  {
    var nextFunc = next.Compile();
    return Nest(
      @<PropertyColumn
         Filterable="false"
         Sortable="false"
         T="TPrefix"
         TProperty="IEnumerable<T>"
         Title="@(Translate(Label(next)))"
         Property="@Wrap(next)">
        <CellTemplate>
          @if (Get(nextFunc)(context.Item) is { } item)
          {
            if (item is IEnumerable<Enum> enumItem)
            {
              <MudText>
                @(string.Join(
                  ", ", enumItem
                    .Select(x => Translate(x.ToString()))))
              </MudText>
            }
            else
            {
              <MudText>
                @string.Join(", ", item)
              </MudText>
            }
          }
        </CellTemplate>
      </PropertyColumn>);
  }

  protected RenderFragment Column(
    Expression<Func<TModel, DateTimeOffset?>> next
  )
  {
    var nextFunc = next.Compile();
    return Nest(
      @<PropertyColumn
         Filterable="false"
         Sortable="false"
         T="TPrefix"
         TProperty="DateTimeOffset?"
         Title="@(Translate(Label(next)))"
         Property="@Wrap(next)">
        <CellTemplate>
          <MudText>
            @if (Get(nextFunc)(context.Item) is { } date)
            {
              @DateTimeString(date)
            }
          </MudText>
        </CellTemplate>
      </PropertyColumn>);
  }

  protected RenderFragment EnumerableColumn<T>(
    Expression<Func<TModel, T?>> next
  )
  {
    var nextFunc = next.Compile();
    return Nest(
      @<PropertyColumn
         Filterable="false"
         Sortable="false"
         T="TPrefix"
         TProperty="T"
         Title="@(Translate(Label(next)))"
         Property="@Wrap(next)">
        <CellTemplate>
          @if (Get(nextFunc)(context.Item) is IEnumerable enumerable)
          {
            <MudText>
              @string.Join(", ", enumerable)
            </MudText>
          }
        </CellTemplate>
      </PropertyColumn>);
  }

  protected RenderFragment EnumerableEnumColumn<T>(
    Expression<Func<TModel, T?>> next
  )
  {
    var nextFunc = next.Compile();
    return Nest(
      @<PropertyColumn
         Filterable="false"
         Sortable="false"
         T="TPrefix"
         TProperty="T"
         Title="@(Translate(Label(next)))"
         Property="@Wrap(next)">
        <CellTemplate>
          @if (Get(nextFunc)(context.Item) is IEnumerable<Enum> enumerable)
          {
            <MudText>
              @(string.Join(
                ", ", enumerable
                  .Select(x => Translate(x.ToString()))))
            </MudText>
          }
        </CellTemplate>
      </PropertyColumn>);
  }

  protected RenderFragment TextColumn<T>(Expression<Func<TModel, T?>> next)
  {
    return Nest(
      @<PropertyColumn
         Filterable="false"
         Sortable="false"
         T="TPrefix"
         TProperty="T"
         Title="@(Translate(Label(next)))"
         Property="@Wrap(next)"/>);
  }

  protected RenderFragment EnumColumn<T>(Expression<Func<TModel, T?>> next)
  {
    var nextFunc = next.Compile();
    return Nest(
      @<PropertyColumn
         Filterable="false"
         Sortable="false"
         T="TPrefix"
         TProperty="T"
         Title="@(Translate(Label(next)))"
         Property="@Wrap(next)">
        <CellTemplate>
          <MudText>
            @if (Get(nextFunc)(context.Item) is { } value
              && value.ToString() is { } valueString)
            {
              @Translate(valueString)
            }
          </MudText>
        </CellTemplate>
      </PropertyColumn>);
  }

  protected RenderFragment DateColumn<T>(Expression<Func<TModel, T?>> next)
  {
    var nextFunc = next.Compile();
    return Nest(
      @<PropertyColumn
         Filterable="false"
         Sortable="false"
         T="TPrefix"
         TProperty="T"
         Title="@(Translate(Label(next)))"
         Property="@Wrap(next)">
        <CellTemplate>
          <MudText>
            @if (Get(nextFunc)(context.Item) is DateTimeOffset date)
            {
              @DateString(date)
            }
          </MudText>
        </CellTemplate>
      </PropertyColumn>);
  }

  protected RenderFragment DateTimeColumn<T>(Expression<Func<TModel, T?>> next)
  {
    var nextFunc = next.Compile();
    return Nest(
      @<PropertyColumn
         Filterable="false"
         Sortable="false"
         T="TPrefix"
         TProperty="T"
         Title="@(Translate(Label(next)))"
         Property="@Wrap(next)">
        <CellTemplate>
          <MudText>
            @if (Get(nextFunc)(context.Item) is DateTimeOffset date)
            {
              @DateTimeString(date)
            }
          </MudText>
        </CellTemplate>
      </PropertyColumn>);
  }

  protected RenderFragment LinkColumn(
    Expression<Func<TModel, IIdentifiable?>> next
  )
  {
    var nextFunc = next.Compile();
    return Nest(
      @<TemplateColumn
         T="TPrefix"
         Title="@(Translate(Label(next.Suffix(x => x!.Title)!)))">
        <CellTemplate>
          @if (Get(nextFunc)(context.Item) is { } model)
          {
            <MudLink Href="@(Provider.CreateLink(model))">
              @model.Title
            </MudLink>
          }
        </CellTemplate>
      </TemplateColumn>);
  }

  protected RenderFragment LinkColumn<T>(
    Expression<Func<TModel, string?>> next
  )
    where T : IIdentifiable
  {
    var nextFunc = next.Compile();
    return Nest(
      @<TemplateColumn
         T="TPrefix"
         Title="@(Translate(Label(next)))">
        <CellTemplate>
          @if (Get(nextFunc)(context.Item) is { } id)
          {
            var href = PageHref(
              Provider.GetPageComponentType(typeof(T)),
              new { id });
            <MudLink Href="@href">
              @id
            </MudLink>
          }
        </CellTemplate>
      </TemplateColumn>);
  }

  protected RenderFragment PolymorphicLinkColumn(
    Expression<Func<TModel, Type?>> type,
    Expression<Func<TModel, string?>> next
  )
  {
    var typeFunc = type.Compile();
    var nextFunc = next.Compile();
    return Nest(
      @<TemplateColumn
         T="TPrefix"
         Title="@(Translate(Label(next)))">
        <CellTemplate>
          @if (Get(typeFunc)(context.Item) is { } type &&
            Get(nextFunc)(context.Item) is { } id)
          {
            var href = PageHref(
              Provider.GetPageComponentType(type),
              new { id });
            <MudLink Href="@href">
              @Translate(type) @id
            </MudLink>
          }
        </CellTemplate>
      </TemplateColumn>);
  }

  protected RenderFragment Nest(
    RenderFragment fragment
  )
  {
    if (Isolate)
    {
      return fragment;
    }

    return Fragment.Nest(2 * NestingLevel, fragment);
  }

}
