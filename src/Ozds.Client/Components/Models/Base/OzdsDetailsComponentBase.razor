@namespace Ozds.Client.Components.Models.Base

@typeparam TModel
@using System.Collections
@using System.Linq.Expressions
@using System.Text.Json
@using MudBlazor
@using Ozds.Business.Models.Abstractions
@using Ozds.Client.Components.Fields
@using Ozds.Client.Components.Streaming
@inherits OzdsManagedModelComponentBase<TModel>

@Base()

@code {

  protected RenderFragment Field(Expression<Func<TModel, string?>> next)
  {
    var nextFunc = next.Compile();
    return @<DetailsField Title="@(Translate(Label(next)))">
             <MudText>
               @nextFunc(Model)
             </MudText>
           </DetailsField>;
  }

  protected RenderFragment Field(Expression<Func<TModel, Enum?>> next)
  {
    var nextFunc = next.Compile();
    return @<DetailsField Title="@(Translate(Label(next)))">
             <MudText>
               @nextFunc(Model)
             </MudText>
           </DetailsField>;
  }

  protected RenderFragment Field(Expression<Func<TModel, decimal?>> next, int decimalPlaces = 2)
  {
    var nextFunc = next.Compile();
    return @<DetailsField Title="@(Translate(Label(next)))">
             <MudText>
               @NumericString(nextFunc(Model), decimalPlaces)
             </MudText>
           </DetailsField>;
  }

  protected RenderFragment Field(Expression<Func<TModel, bool?>> next)
  {
    var nextFunc = next.Compile();
    var value = nextFunc(Model);
    return @<DetailsField Title="@(Translate(Label(next)))">
             <MudText>
               @if (value is bool @bool)
               {
                 @if (@bool)
                 {
                   <MudIcon
                     Color="@Color.Success"
                     Icon="@Icons.Material.Filled.Check"/>
                 }
                 else
                 {
                   <MudIcon
                     Color="@Color.Error"
                     Icon="@Icons.Material.Filled.Cancel"/>
                 }
               }
               else
               {
                 <MudIcon
                   Color="@Color.Warning"
                   Icon="@Icons.Material.Filled.QuestionMark"/>
               }
             </MudText>
           </DetailsField>;
  }

  protected RenderFragment Field(Expression<Func<TModel, DateTimeOffset?>> next)
  {
    var nextFunc = next.Compile();
    return @<DetailsField Title="@(Translate(Label(next)))">
             <MudText>
               @DateTimeString(nextFunc(Model))
             </MudText>
           </DetailsField>;
  }

  protected RenderFragment Field(Expression<Func<TModel, JsonDocument?>> next)
  {
    var nextFunc = next.Compile();
    return @<DetailsField Title="@(Translate(Label(next)))" LargeContent>
             <MudText>
               <pre>
          @JsonString(nextFunc(Model))
        </pre>
             </MudText>
           </DetailsField>;
  }

  protected RenderFragment Field<T>(
    Expression<Func<TModel, IEnumerable<T>?>> next
  )
  {
    var nextFunc = next.Compile();
    return @<DetailsField Title="@(Translate(Label(next)))">
             <MudText>
               @if (nextFunc(Model) is { } model)
               {
                 if (model is IEnumerable<Enum> enums)
                 {
                   @(string.Join(
                     ", ", enums
                       .Select(x => Translate(x.ToString()))))
                 }
                 else
                 {
                   @string.Join(", ", model)
                 }
               }
               else
               {
                 @Translate("None")
               }
             </MudText>
           </DetailsField>;
  }

  protected RenderFragment TextField<T>(Expression<Func<TModel, T?>> next)
  {
    var nextFunc = next.Compile();
    return @<DetailsField Title="@(Translate(Label(next)))">
             <MudText>
               @nextFunc(Model)
             </MudText>
           </DetailsField>;
  }

  protected RenderFragment HtmlField(Expression<Func<TModel, string?>> next)
  {
    var nextFunc = next.Compile();
    return @<DetailsField Title="@(Translate(Label(next)))" LargeContent>
             @if (nextFunc(Model) is { } html)
             {
               @(new MarkupString(html))
             }
             else
             {
               @Translate("None")
             }
           </DetailsField>;
  }

  protected RenderFragment PreField<T>(Expression<Func<TModel, T?>> next)
  {
    var nextFunc = next.Compile();
    return @<DetailsField Title="@(Translate(Label(next)))" LargeContent>
             <MudText>
               <pre>
          @nextFunc(Model)
        </pre>
             </MudText>
           </DetailsField>
        ;
    }

  protected RenderFragment ScrollablePreField<T>(
    Expression<Func<TModel, T?>> next,
    int maxHeight = 600
  )
  {
    var nextFunc = next.Compile();
    var value = nextFunc(Model);
    return @<DetailsField Title="@(Translate(Label(next)))" MaxWidth="100%" LargeContent>
            @if (value is null)
             {
               <MudText>@Translate("None")</MudText>
             }
             else
             {
               <MudPaper Elevation="1"
                         Class="pa-2"
                         Style="@($"max-height:{maxHeight}px; overflow-y:auto; overscroll-behavior: none;")">
                 <pre
                 class="ma-0"
                 style="white-space: pre-wrap; word-break: break-word; overflow-wrap: anywhere;">
                  @value
                 </pre>
               </MudPaper>
             }
           </DetailsField>;
  }

  protected RenderFragment NumericField<T>(Expression<Func<TModel, T?>> next, int decimalPlaces = 2)
  {
    var nextFunc = next.Compile();
    var value = nextFunc(Model);
    return @<DetailsField Title="@(Translate(Label(next)))">
             <MudText>
               @if (value is decimal @decimal)
               {
                 @NumericString(@decimal, decimalPlaces)
               }
               else
               {
                 if (value is not null)
                 {
                   @value
                 }
                 else
                 {
                   @Translate("None")
                 }
               }
             </MudText>
           </DetailsField>;
  }

  protected RenderFragment BoolField<T>(Expression<Func<TModel, T?>> next)
  {
    var nextFunc = next.Compile();
    var value = nextFunc(Model);
    return @<DetailsField Title="@(Translate(Label(next)))">
             <MudText>
               @if (value is bool @bool)
               {
                 if (@bool)
                 {
                   <MudIcon
                     Color="@Color.Success"
                     Icon="@Icons.Material.Filled.Check"/>
                 }
                 else
                 {
                   <MudIcon
                     Color="@Color.Error"
                     Icon="@Icons.Material.Filled.Cancel"/>
                 }
               }
               else
               {
                 <MudIcon
                   Color="@Color.Warning"
                   Icon="@Icons.Material.Filled.QuestionMark"/>
               }
             </MudText>
           </DetailsField>;
  }

  protected RenderFragment DateTimeField<T>(Expression<Func<TModel, T?>> next)
  {
    var nextFunc = next.Compile();
    var value = nextFunc(Model);
    return @<DetailsField Title="@(Translate(Label(next)))">
             <MudText>
               @if (value is DateTimeOffset @decimal)
               {
                 @DateTimeString(@decimal)
               }
               else
               {
                 if (value is not null)
                 {
                   @value
                 }
                 else
                 {
                   @Translate("None")
                 }
               }
             </MudText>
           </DetailsField>;
  }

  protected RenderFragment DateField<T>(Expression<Func<TModel, T?>> next)
  {
    var nextFunc = next.Compile();
    var value = nextFunc(Model);
    return @<DetailsField Title="@(Translate(Label(next)))">
             <MudText>
               @if (value is DateTimeOffset @decimal)
               {
                 @DateString(@decimal)
               }
               else
               {
                 if (value is not null)
                 {
                   @value
                 }
                 else
                 {
                   @Translate("None")
                 }
               }
             </MudText>
           </DetailsField>;
  }

  protected RenderFragment JsonField<T>(Expression<Func<TModel, T?>> next)
  {
    var nextFunc = next.Compile();
    var value = nextFunc(Model);
    return @<DetailsField Title="@(Translate(Label(next)))" LargeContent>
             <MudText>
               <pre>
          @if (value is JsonDocument @decimal)
          {
            @JsonString(@decimal)
          }
          else
          {
            if (value is not null)
            {
              @value
            }
            else
            {
              @Translate("None")
            }
          }
        </pre>
             </MudText>
           </DetailsField>;
  }

  protected RenderFragment EnumerableField<T>(
    Expression<Func<TModel, T?>> next
  )
  {
    var nextFunc = next.Compile();
    return @<DetailsField Title="@(Translate(Label(next)))">
             <MudText>
               @if (nextFunc(Model) is IEnumerable model)
               {
                 @string.Join(", ", model)
               }
               else
               {
                 @Translate("None")
               }
             </MudText>
           </DetailsField>;
  }

  protected RenderFragment EnumerableEnumField<T>(
    Expression<Func<TModel, T?>> next
  )
  {
    var nextFunc = next.Compile();
    return @<DetailsField Title="@(Translate(Label(next)))">
             <MudText>
               @if (nextFunc(Model) is IEnumerable<Enum> model)
               {
                 @(string.Join(
                   ", ", model
                     .Select(x => Translate(x.ToString()))))
               }
               else
               {
                 @Translate("None")
               }
             </MudText>
           </DetailsField>;
  }

  protected RenderFragment LinkField<T>(
    Expression<Func<TModel, string?>> next
  )
    where T : IIdentifiable
  {
    var nextFunc = next.Compile();
    var id = nextFunc(Model);
    var href = id is null
      ? null
      : PageHref(Provider.GetPageComponentType(typeof(T)), new { id });
    return @<DetailsField Title="@(Translate(Label(next)))">
             @if (id is null || href is null)
             {
               @Translate("None")
             }
             else
             {
               <MudLink Href="@href">
                 @id
               </MudLink>
             }
           </DetailsField>;
  }

  protected RenderFragment TitleLinkField<T>(
    Expression<Func<TModel, string?>> next
  )
    where T : IIdentifiable
  {
      var nextFunc = next.Compile();
      var id = nextFunc(Model);
      var href = id is null
        ? null
        : PageHref(Provider.GetPageComponentType(typeof(T)), new { id });
      return @<DetailsField Title="@(Translate(Label(next)))">
          @if (id is null || href is null)
          {
              @Translate("None")
          }
          else
          {
            <Loading T="T" Id="@id">

              <Found Context="model">
                <MudLink Href="@href">
                  @model.Title
                </MudLink>
              </Found>

              <Progress>
                <MudLink Href="@href">
                  @id
                </MudLink>
              </Progress>

            </Loading>
          }
      </DetailsField>;
  }

  protected RenderFragment PolymorphicLinkField(
    Expression<Func<TModel, Type?>> type,
    Expression<Func<TModel, string?>> next
  )
  {
    var typeFunc = type.Compile();
    var nextFunc = next.Compile();
    var ty = typeFunc(Model);
    var id = nextFunc(Model);
    var href = id is null || ty is null
      ? null
      : PageHref(Provider.GetPageComponentType(ty), new { id });
    return @<DetailsField Title="@(Translate(Label(next)))">
             @if (id is null || href is null || ty is null)
             {
               @Translate("None")
             }
             else
             {
               <MudLink Href="@href">
                 @Translate(ty) @id
               </MudLink>
             }
           </DetailsField>;
  }

  protected RenderFragment ArchivedField<T>(
    Expression<Func<TModel, T?>> next
  )
  {
    var nextFunc = next.Compile();
    var archived = nextFunc(Model);
    return @<CollapseField Title="@(Translate(Label(next)))">
             <Details Model="@archived"/>
           </CollapseField>;
  }

}
