  {
    var nextFunc = next.Compile();
    return @<MultiEnumPicker
              Title="@(Translate(Label(next)))"
              Value="@Get(nextFunc)"
              ValueChanged="@Set(next, (IEnumerable<T> x) => x.ToList())"/>;
  }

  protected RenderFragment StringEnumField<T>(
    Expression<Func<TModel, T?>> next,
    IEnumerable<T> choices
  )
  {
    var nextFunc = next.Compile();
    return @<SelectField
              T="T"
              Label="@(Translate(Label(next)))"
              Value="@Get(nextFunc)"
              ValueChanged="@Set(next)">
             @foreach (var choice in choices)
             {
               @if (choice is string stringChoice)
               {
                 <MudSelectItem Value="@choice">
                   @Translate(stringChoice)
                 </MudSelectItem>
               }
               else if (
                 choice is { } nonNullChoice
                 && nonNullChoice.ToString() is { } nonNullChoiceString)
               {
                 <MudSelectItem Value="@nonNullChoice">
                   @Translate(nonNullChoiceString)
                 </MudSelectItem>
               }
             }
           </SelectField>;
  }

  protected RenderFragment LinkField<T>(
    Expression<Func<TModel, string?>> next
  )
    where T : IIdentifiable
  {
    var nextFunc = next.Compile();
    return @<Paging T="T" Scroll="Scroll.Infinite">
             <Found Context="models">
               <SelectField Label="@(Translate(Label(next)))"
                            Value="@Get(nextFunc)"
                            ValueChanged="@Set(next)"
                            For="@For(next)">
                 @foreach (var model in models.Items)
                 {
                   <MudSelectItem Value="@model.Id">
                     <MudText>
                       @model.Title
                     </MudText>
                   </MudSelectItem>
                 }
               </SelectField>
             </Found>
           </Paging>;
  }

  protected RenderFragment PolymorphicLinkField(
    Expression<Func<TModel, Type?>> type,
    Expression<Func<TModel, string?>> next
  )
  {
    var nextFunc = next.Compile();
    var typeFunc = type.Compile();

    RenderFragment<PaginatedList> Found = models =>
    {
      return @<SelectField Label="@(Translate(Label(next)))"
                           Value="@Get(nextFunc)"
                           ValueChanged="@Set(next)"
                           For="@For(next)">
               @foreach (var model in models.ObjectItems.OfType<IIdentifiable>())
               {
                 <MudSelectItem Value="@model.Id">
                   <MudText>
                     @model.Title
                   </MudText>
                 </MudSelectItem>
               }
             </SelectField>;
    };

    var actualType = Get(typeFunc);

    if (actualType is null)
    {
      return @<Fragment/>;
    }

    var componentType = typeof(Paging<>).MakeGenericType(actualType);
    var listType = typeof(PaginatedList<>).MakeGenericType(actualType);

#pragma warning disable CS8974
    var parameters = new Dictionary<string, object>
    {
      { "Found", Found.Concretize(listType) },
      { "Scroll", Scroll.Infinite }
    };
#pragma warning restore CS8974

    return @<DynamicComponent
              Type="@(componentType)"
              Parameters="@parameters"/>;
  }

  protected RenderFragment PolymorphicLinkField(
    Expression<Func<TModel, string?>> type,
    Expression<Func<TModel, string?>> id,
    IEnumerable<Type?> choices
  )
  {
    var typeFunc = type.Compile();
    var idFunc = id.Compile();

    return @<PolymorphicIdField
              TypeLabel="@(Translate(Label(type)))"
              Type="@(Get(typeFunc))"
              TypeChanged="@(Set(type))"
              TypeChoices="@choices"
              IdLabel="@(Translate(Label(id)))"
              Id="@(Get(idFunc))"
              IdChanged="@(Set(id))"/>;
  }

}
