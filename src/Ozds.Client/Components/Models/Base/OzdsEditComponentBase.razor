              Value="@Get(nextFunc)"
              ValueChanged="@Set(next)"
              For="@For(next)"/>;
  }

  protected RenderFragment BoolField<T>(Expression<Func<TModel, T>> next)
    where T : struct
  {
    var nextFunc = next.Compile();
    return @<MudCheckBox
              Label="@(Translate(Label(next)))"
              Value="@Get(nextFunc)"
              ValueChanged="@Set(next)"
              For="@For(next)"/>;
