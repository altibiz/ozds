    return @<MudCheckBox
              Label="@(Translate(Label(next)))"
              Value="@Get(nextFunc)"
              ValueChanged="@Set(next)"
              For="@For(next)"/>;
  }

  protected RenderFragment Field(Expression<Func<TModel, bool>> next)
  {
    var nextFunc = next.Compile();
    return @<MudCheckBox
              Label="@(Translate(Label(next)))"
              Value="@Get(nextFunc)"
              ValueChanged="@Set(next)"
              For="@For(next)"/>;
  }

  protected RenderFragment Field(
    Expression<Func<TModel, DateTime?>> next
  )
  {
    var nextFunc = next.Compile();
    return @<MudDatePicker
              Label="@Translate(Label(next))"
              Date="@Get(nextFunc)"
              DateChanged="@Set(next)"
              DateFormat="@DateFormat()"/>;
  }

  protected RenderFragment Field(
    Expression<Func<TModel, DateTimeOffset?>> next
  )
  {
    var nextFunc = next.Compile();
    var timeZone = GetTimeZone();
    return @<MudDatePicker
              Label="@Translate(Label(next))"
              Date="@Get(nextFunc)?.DateTime"
              DateChanged="@Set(next, (DateTime? x) => x == null ? null : new DateTimeOffset(x.Value, timeZone.BaseUtcOffset).ToUniversalTime())"
              DateFormat="@DateFormat()"/>;
  }

  // NOTE: doesn't work with just Enum
  protected RenderFragment Field<T>(Expression<Func<TModel, T?>> next)
    where T : Enum
  {
    var nextFunc = next.Compile();
    return @<EnumPicker
              Title="@(Translate(Label(next)))"
              Value="@Get(nextFunc)"
              ValueChanged="@Set(next)"
              For="@For(next)"/>;
  }

  // NOTE: doesn't work with just Enum
  protected RenderFragment Field<T>(
    Expression<Func<TModel, HashSet<T>?>> next
  )
    where T : Enum
  {
    var nextFunc = next.Compile();
    return @<MultiEnumPicker
              Title="@(Translate(Label(next)))"
              Value="@Get(nextFunc)"
              ValueChanged="@Set(next, (IEnumerable<T>? x) => x!.ToHashSet())"/>;
  }

  // NOTE: doesn't work with just Enum
  protected RenderFragment Field<T>(
    Expression<Func<TModel, List<T>?>> next
  )
    where T : Enum
  {
    var nextFunc = next.Compile();
    return @<MultiEnumPicker
              Title="@(Translate(Label(next)))"
              Value="@Get(nextFunc)"
              ValueChanged="@Set(next, (IEnumerable<T>? x) => x!.ToList())"/>;
  }

  protected RenderFragment TextField<T>(Expression<Func<TModel, T?>> next)
  {
    var nextFunc = next.Compile();
    return @<MudTextField
              Label="@(Translate(Label(next)))"
              Value="@Get(nextFunc)"
              ValueChanged="@Set(next)"
              For="@For(next)"/>;
  }

  protected RenderFragment ChoiceField<T>(
    Expression<Func<TModel, T?>> next,
    IEnumerable<(string Label, T Value)> choices
  )
  {
    var nextFunc = next.Compile();
    return @<SelectField
              Label="@(Translate(Label(next)))"
              Value="@Get(nextFunc)"
              ValueChanged="@Set(next)">
             @foreach (var choice in choices)
             {
               <MudSelectItem Value="@choice.Value">
                 @choice.Label
               </MudSelectItem>
             }
           </SelectField>;
  }

  protected RenderFragment PasswordField(Expression<Func<TModel, string?>> next)
  {
    var nextFunc = next.Compile();
    return @<PasswordField
              Label="@(Translate(Label(next)))"
              Value="@Get(nextFunc)"
              ValueChanged="@Set(next)"
              For="@For(next)"/>;
  }

  protected RenderFragment HtmlField(Expression<Func<TModel, string?>> next)
  {
    var nextFunc = next.Compile();
    return @<div>
             <p>
               @Translate(Label(next))
             </p>
             <MudHtmlEditor
               Placeholder="..."
               Html="@Get(nextFunc)"
               HtmlChanged="@Set(next)"/>
           </div>;
  }

  protected RenderFragment NumericField<T>(Expression<Func<TModel, T?>> next)
    where T : struct
  {
    var nextFunc = next.Compile();
    return @<MudNumericField
              Label="@(Translate(Label(next)))"
              Value="@Get(nextFunc)"
              ValueChanged="@Set(next)"
              For="@For(next)"/>;
  }

  protected RenderFragment NumericField<T>(Expression<Func<TModel, T>> next)
    where T : struct
  {
    var nextFunc = next.Compile();
    return @<MudNumericField
              Label="@(Translate(Label(next)))"
