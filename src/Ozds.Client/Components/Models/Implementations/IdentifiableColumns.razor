@namespace Ozds.Client.Components.Models

@typeparam TPrefix
@typeparam TModel where TModel : Ozds.Business.Models.Abstractions.IIdentifiable
@using MudBlazor
@inherits Ozds.Client.Components.Models.Base.OzdsColumnsComponentBase<TPrefix, TModel>

<TemplateColumn
  T="TPrefix"
  Title="@Translate(Label(x => x.Title))">
  <CellTemplate>
    @if (Raw(context.Item) is { } model)
    {
      <MudLink Href="@(Provider.CreateLink(model))">
        @(string.IsNullOrEmpty(model.Title) ? $"[{Translate("No title exists")}]" : model.Title)
      </MudLink>
    }
  </CellTemplate>
</TemplateColumn>
