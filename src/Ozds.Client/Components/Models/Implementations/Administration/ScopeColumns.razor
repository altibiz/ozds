@namespace Ozds.Client.Components.Models.Implementations.Administration

@typeparam TPrefix
@typeparam TModel where TModel : Ozds.Business.Models.Abstractions.IScope
@using Ozds.Business.Models.Abstractions
@using Ozds.Business.Reflection
@inherits Ozds.Client.Components.Models.Base.OzdsColumnsComponentBase<TPrefix, TModel>

@inject ModelReflector ModelReflector

@(Base<IIdentifiable>())

@Column(x => x.ScopeAction)

@(
PolymorphicLinkColumn(
  x => x.ScopeModelType == null
    ? null
    : ModelReflector.ResolveModelType(x.ScopeModelType),
  x => x.ScopeModelId))
