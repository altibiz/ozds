@namespace Ozds.Client.Components.Models.Implementations.Administration
@using Ozds.Business.Models.Abstractions
@using Ozds.Business.Reflection
@inherits Ozds.Client.Components.Models.Base.OzdsDetailsComponentBase<Ozds.Business.Models.ApiKeyModel>
@inject ModelReflector ModelReflector

@(Base<IIdentifiable>())

@(
PolymorphicLinkField(
  x => x.PrincipalModelType == null
    ? null
    : ModelReflector.ResolveModelType(x.PrincipalModelType),
  x => x.PrincipalModelId))

@Field(x => x.ExpiresOn)

@(Base<ITrackable>())
