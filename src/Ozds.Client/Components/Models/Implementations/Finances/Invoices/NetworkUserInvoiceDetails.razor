@namespace Ozds.Client.Components.Models
@using Ozds.Client.Components.Fields
@inherits Ozds.Client.Components.Models.Base.OzdsDetailsComponentBase<Ozds.Business.Models.NetworkUserInvoiceModel>

@{
  var title =
    $"{Translate("INVOICE FOR")} {Model.FromDate.Month}. {Translate("MONTH")}";
}
<FieldSection Title="@title">
  <DetailsField Title="@Translate("ZDS")">
    @(Model.ArchivedLocation.Title)
  </DetailsField>
  <DetailsField Title="@Translate("User")">
    @(Model.ArchivedNetworkUser.Title)
  </DetailsField>
  <DetailsField Title="@Translate("From")">
    @DateString(Model.FromDate)
  </DetailsField>
  <DetailsField Title="@Translate("To")">
    @DateString(Model.ToDate)
  </DetailsField>
</FieldSection>

<FieldSection Class="mt-8" Title="@(Translate("ZDS network usage fee"))" Unit="EUR">
  <DetailsField Title="@Translate("Network usage during unique daily tariff period")">
    @NumericString(Model.UsageActiveEnergyTotalImportT0Fee_EUR)
  </DetailsField>
  <DetailsField Title="@Translate("Network usage during higher daily tariff period")">
    @NumericString(Model.UsageActiveEnergyTotalImportT1Fee_EUR)
  </DetailsField>
  <DetailsField Title="@Translate("Network usage during lower daily tariff period")">
    @NumericString(Model.UsageActiveEnergyTotalImportT2Fee_EUR)
  </DetailsField>
  <DetailsField Title="@Translate("Engaged power during higher daily tariff period")">
    @NumericString(Model.UsageActivePowerTotalImportT1PeakFee_EUR)
  </DetailsField>
  <DetailsField Title="@Translate("Excessively drawn reactive energy")">
    @NumericString(Model.UsageReactiveEnergyTotalRampedT0Fee_EUR)
  </DetailsField>
  <DetailsField Title="@Translate("Measurement service fee")">
    @NumericString(Model.UsageMeterFee_EUR)
  </DetailsField>
</FieldSection>
<DetailsField Title="@Translate("TOTAL")" Unit="EUR">
  @NumericString(Model.UsageFeeTotal_EUR)
</DetailsField>

<FieldSection Title="@Translate("Electrical energy supply fee")" Unit="EUR">
  <DetailsField Title="@Translate("Electrical energy supply during higher daily tariff period")">
    @NumericString(Model.SupplyActiveEnergyTotalImportT1Fee_EUR)
  </DetailsField>
  <DetailsField Title="@Translate("Electrical energy supply during lower daily tariff period")">
    @NumericString(Model.SupplyActiveEnergyTotalImportT2Fee_EUR)
  </DetailsField>
  <DetailsField Title="@Translate("Fee for promoting production from renewable energy sources and cogeneration")">
    @NumericString(Model.SupplyRenewableEnergyFee_EUR)
  </DetailsField>
  <DetailsField Title="@Translate("Excise duty for business/non-business use")">
    @NumericString(Model.SupplyBusinessUsageFee_EUR)
  </DetailsField>
</FieldSection>
<DetailsField Title="@Translate("TOTAL")" Unit="EUR">
  @NumericString(Model.SupplyFeeTotal_EUR)
</DetailsField>

<FieldSection Class="mt-8">
  <DetailsField Title="@Translate("Total")">
    @NumericString(Model.Total_EUR)
  </DetailsField>
  <DetailsField Title="@(Translate("VAT") + " " + NumericString(Model.TaxRate_Percent) + "%")">
    @NumericString(Model.Total_EUR)
  </DetailsField>
  <DetailsField Title="@Translate("Full total")">
    @NumericString(Model.TotalWithTax_EUR)
  </DetailsField>
</FieldSection>
