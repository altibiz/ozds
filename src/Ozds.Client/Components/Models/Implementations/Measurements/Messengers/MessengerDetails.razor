@namespace Ozds.Client.Components.Models
@using MudBlazor
@using Ozds.Business.Models
@using Ozds.Business.Models.Abstractions
@using Ozds.Client.Components.Fields
@inherits Ozds.Client.Components.Models.Base.OzdsDetailsComponentBase<Ozds.Business.Models.Abstractions.IMessenger>

@(Base<IIdentifiable>())

@(LinkField<LocationModel>(x => x.LocationId))

<DetailsField Title="@(Translate("Max inactivity"))">
  <MudText>
    @TranslatePeriod(Model.MaxInactivityPeriod)
  </MudText>
</DetailsField>

<DetailsField Title="@(Translate("Push delay"))">
  <MudText>
    @TranslatePeriod(Model.PushDelayPeriod)
  </MudText>
</DetailsField>

@(Base<IAuditable>())
