@namespace Ozds.Client.Components.Layout
@using Microsoft.AspNetCore.Antiforgery
@using MudBlazor
@inherits Ozds.Client.Components.Base.OzdsComponentBase

@inject IAntiforgery Antiforgery
@inject IHttpContextAccessor HttpContextAccessor
@inject ILogger<UserDrawer> Logger

<style>
  .user-drawer-link .mud-nav-link {
    padding-inline: 0;
  }

  .user-drawer-link .mud-nav-link-text {
    margin-left: 0;
  }
</style>

<MudDrawer
  Open="@LayoutState.IsUserDrawerOpen"
  OpenChanged="open => LayoutState.SetUserDrawerOpen(open)"
  Elevation="0"
  Anchor="@LayoutState.DrawerAnchor"
  Variant="DrawerVariant.Temporary"
  ClipMode="DrawerClipMode.Never">
  <MudDrawerHeader Class="px-0">
    <MudContainer
      MaxWidth="@MaxWidth"
      Class="@($"d-flex flex-row justify-center align-center {Class}")"
      Style="@($"width: 100%; {Style}")">
      <MudText Typo="Typo.h6">
        @(UserState?.User.Name)
      </MudText>
    </MudContainer>
  </MudDrawerHeader>
  <MudDivider/>
  <MudDrawerContainer>
    <MudNavMenu>
      <MudNavLink OnClick="OnAccountClick" Class="user-drawer-link">
        <MudContainer
          MaxWidth="@MaxWidth"
          Class="@($"d-flex flex-row {Class}")"
          Style="@($"width: 100%; {Style}")">
          <MudHidden Breakpoint="Breakpoint.Xs">
            <div
              class="d-flex flex-row align-center">
              <MudIcon Icon="@Icons.Material.Filled.Person"/>
            </div>
          </MudHidden>
          <MudHidden Breakpoint="Breakpoint.SmAndUp">
            <div
              class="d-flex flex-row align-center">
              <MudIcon Icon="@Icons.Material.Filled.Person"/>
            </div>
          </MudHidden>
          <MudText Class="ml-4">
            @Translate("Account")
          </MudText>
        </MudContainer>
      </MudNavLink>
      <MudForm method="post" action="@LogoutHref">
        <input
          type="hidden"
          name="__RequestVerificationToken"
          value="@UserState.LogoutToken"/>
        <MudButton
          ButtonType="ButtonType.Submit"
          DropShadow="false"
          Ripple="false"
          OnClick="OnLogoutClick"
          Style="width: 100%;">
          <MudContainer
            MaxWidth="@MaxWidth"
            Class="@($"d-flex flex-row {Class}")"
            Style="@($"width: 100%; {Style}")">
            <MudHidden Breakpoint="Breakpoint.Xs">
              <div
                class="d-flex flex-row align-center">
                <MudIcon Icon="@Icons.Material.Filled.Login"/>
              </div>
            </MudHidden>
            <MudHidden Breakpoint="Breakpoint.SmAndUp">
              <div
                style="margin-left: -9px;"
                class="d-flex flex-row align-center">
                <MudIcon Icon="@Icons.Material.Filled.Login"/>
              </div>
            </MudHidden>
            <MudText Class="ml-4">
              @Translate("Logout")
            </MudText>
          </MudContainer>
        </MudButton>
      </MudForm>
    </MudNavMenu>
  </MudDrawerContainer>
</MudDrawer>

@code {

  [Parameter]
  public MaxWidth MaxWidth { get; set; }

  [Parameter]
  public string Style { get; set; } = string.Empty;

  [Parameter]
  public string Class { get; set; } = string.Empty;

}
