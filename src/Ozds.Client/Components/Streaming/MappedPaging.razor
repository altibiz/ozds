@namespace Ozds.Client.Components.Streaming

@typeparam T where T : notnull
@typeparam TMapped
@using MudBlazor
@using Ozds.Business.Queries.Abstractions
@using Ozds.Client.Components.Models
@inherits Ozds.Client.Components.Base.OzdsComponentBase

<MappedLoading
  T="PaginatedList<T>"
  TMapped="PaginatedList<TMapped>"
  Map="@(LoadingMap!)"
  @ref="loading"
  Value="@(LoadingValue!)"
  Load="@(OnPage!)"
  LoadAsync="@(OnPageAsync!)"
  Progress="@(Progress!)"
  Error="@(Error!)"
  Class="@Class"
  Style="@Style">
  <NotFound>
    <NotFound Type="@typeof(T)"/>
  </NotFound>
  <Found Context="page">
    @if (page.Items.Count == 0)
    {
      if (Empty is not null)
      {
        @Empty
      }
      else
      {
        <Empty Type="@typeof(T)"/>
      }
    }
    else
    {
      if (Found is not null)
      {
        @Found(page)
      }
      else if (Summary is not null)
      {
        foreach (var item in page.Items)
        {
          @Summary(item)
        }
      }
      else
      {
        foreach (var item in page.Items)
        {
          <Summary Model="@item"/>
        }
      }

      if (page.TotalCount > page.Items.Count)
      {
        if (Pagination is not null)
        {
          @Pagination(
            new PaginationOptions(
              PageCount,
              pageNumber,
              page.TotalCount,
              SetPageNumber
            )
          )
        }
        else
        {
          @if (Scroll == Scroll.Paged)
          {
            <div style="width: 100%;">
              <MudPagination
                BoundaryCount="1"
                MiddleCount="1"
                Rectangular="true"
                Variant="Variant.Filled"
                Class="my-4 d-flex justify-center"
                Count="@((int)Math.Ceiling(page.TotalCount / (double)PageCount))"
                Selected="@(pageNumber + 1)"
                SelectedChanged="@SetPageNumber"/>
            </div>
          }
          else
          {
            <div
              id="@infiniteScrollId"
              style="width: 100%; text-align: center;">
              <MudProgressCircular/>
            </div>
            <MudScrollToTop>
              <MudFab
                Color="Color.Tertiary"
                StartIcon="@Icons.Material.Filled.ArrowCircleUp"/>
            </MudScrollToTop>
          }
        }
      }
    }
  </Found>
</MappedLoading>

<script>
  if (window.observeElement == undefined) {
    window.observeElement = (elementId, dotNetHelper) => {
      const element = document.getElementById(elementId);

      if (!element) {
        console.error(`Element with id ${elementId} not found.`);
        return;
      }

      const observer = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
          dotNetHelper.invokeMethodAsync(
            'OnScrollInView',
            elementId,
            entry.isIntersecting);
        });
      });

      observer.observe(element);
    };
  }
</script>
