@namespace Ozds.Client.Components.Streaming

@typeparam T
@using MudBlazor
@using Ozds.Client.Components.Models
@inherits Ozds.Client.Components.Base.OzdsComponentBase

<MudHidden Breakpoint="Breakpoint.MdAndUp">
 <MudText Typo="Typo.h6">
    @(Model is not null
      ? Translate(Model.GetType().GetGenericArguments()[0])
      : "")
  </MudText>
  <MudTextField
    T="string"
    Value="@searchString"
    ValueChanged="@OnPagingSearch"
    Placeholder="@Translate("Search")"
    Adornment="Adornment.Start"
    Immediate="true"
    AdornmentIcon="@Icons.Material.Filled.Search"
    IconSize="Size.Medium" />
  <Paging PageCount="@PageCount" T="T" PageAsync="@OnPagingPage">
    <Found Context="page">
      @foreach (var item in page.Items)
      {
        if (!Filter(item))
          continue;

        <MudPaper Class="pa-4 mb-2" Elevation="1">
          <TableCollapse>
            <Summary>
              @if (Summary is null)
              {
                <Summary Model="item" />
              }
              else
              {
                @Summary(item)
              }
            </Summary>
            <Details>
              @if (Details is null)
              {
                <Details Model="item" />
              }
              else
              {
                @Details(item)
              }
            </Details>
          </TableCollapse>
        </MudPaper>
      }
    </Found>
  </Paging>
</MudHidden>

<MudHidden Breakpoint="Breakpoint.SmAndDown">
  <MudDataGrid
    T="T"
    Filterable="true"
    SortMode="@SortMode.None"
    ServerData="@OnDataGridServerData"
    RowsPerPage="@PageCount"
    @ref="@dataGrid">
    <ToolBarContent>
      <MudText Typo="Typo.h6">@(Model is not null ? Translate(Model.GetType().GetGenericArguments()[0]) : "")</MudText>
      <MudSpacer />
      <MudTextField
        T="string"
        Value="@searchString"
        ValueChanged="@OnDataGridSearch"
        Placeholder="@Translate("Search")"
        Adornment="Adornment.Start"
        Immediate="true"
        AdornmentIcon="@Icons.Material.Filled.Search"
        IconSize="Size.Medium">
      </MudTextField>
    </ToolBarContent>
    <Columns>
      @if (Columns is null)
      {
        <Columns TPrefix="T" Models="@model.Items"/>
      }
      else
      {
        @Columns(model.Items)
      }
    </Columns>
    <PagerContent>
      <MudDataGridPager PageSizeSelector="false" T="T"/>
    </PagerContent>
  </MudDataGrid>
</MudHidden>

<style>
  .mud-drop-container{ user-select: text !important; }
</style>
