@namespace Ozds.Client.Components.Streaming
@inherits Ozds.Client.Components.Base.OzdsComponentBase

<InnerErrorBoundary This="this" @ref="@inner">
  <ChildContent>
    @ChildContent
  </ChildContent>
  <ErrorContent>
    <div>
      <div>
        @context
      </div>
      <div>
        <button @onclick="@OnRecover">
          @Translate("Recover")
        </button>
      </div>
    </div>
  </ErrorContent>
</InnerErrorBoundary>
