@namespace Ozds.Client.Components.Streaming
@using MudBlazor
@inherits Ozds.Client.Components.Base.OzdsComponentBase

<HeadContent>
  <title>OZDS</title>
</HeadContent>

<MudText Typo="Typo.h5">
  @if (Type is { } type)
  {
    @string.Format(
      Translate("The resource of type {0} doesn't exist"),
      Translate(type))
  }
  else
  {
    @Translate("The resource you were looking for doesn't exist")
  }
</MudText>

@code {

  [Parameter]
  public Type? Type { get; set; }

}
