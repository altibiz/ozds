@namespace Ozds.Document.Components
@using Ozds.Document.Entities
@inherits DocumentBase

<div>
  <p>
    <strong>
      <u>
        @Translate("SPECIFICATION OF CONSUMPTION AT BILLING MEASUREMENT LOCATION")
      </u>
    </strong>
  </p>
  <p style="margin-top: 0.8rem;">
    @Translate("Name of the billing measurement location (OMM)"):
    @(Entity.MeasurementLocationTitle)
  </p>
  <p>
    @Translate("Number of the billing measurement location (OMM)"):
    @(Entity.MeasurementLocationId)
  </p>
  <p>
    @Translate("Tariff model"): @TariffModelTitle
  </p>
  <p style="margin-top: 1.2rem; margin-left: 0.8rem;">
    <strong>@Translate("A) ZDS NETWORK USAGE FEE")</strong>
  </p>
  <table class="calculation-table" style="margin-top: 0.8rem; width: 100%">
    <colgroup>
      <col style="width: 15%"/>
      <col style="width: 8%"/>
      <col style="width: 8%"/>
      <col style="width: 9%"/>
      <col style="width: 10%"/>
      <col style="width: 10%"/>
      <col style="width: 6%"/>
      <col style="width: 12%"/>
      <col style="width: 8%"/>
      <col style="width: 8%"/>
    </colgroup>
    <thead>
    <tr class="header">
      <th>@Translate("Device number")</th>
      <th>@Translate("Date from")</th>
      <th>@Translate("Date to")</th>
      <th>@Translate("Tariff item")</th>
      <th>@Translate("Status from")</th>
      <th>@Translate("Status to")</th>
      <th>@Translate("Status")</th>
      <th>@Translate("Usage") (kWh/kW/kVAR)</th>
      <th>@Translate("Price") (EUR)</th>
      <th>@Translate("Total") (EUR)</th>
    </tr>
    </thead>
    <tbody>
    <tr class="odd">
      <td rowspan="@UsageRowspan">
        @(Entity.MeterId)
      </td>
      <td rowspan="@UsageRowspan">
        @Date(Entity.FromDate)
      </td>
      <td rowspan="@UsageRowspan">
        @Date(Entity.ToDate)
      </td>
      @(
      Entity.UsageItems.FirstOrDefault() is { } usageItem
        ? RenderItem(usageItem)
        : null)
    </tr>
    @foreach (var item in Entity.UsageItems.Skip(1))
    {
      <tr>
        @RenderItem(item)
      </tr>
    }
    <tr class="odd">
      <td colspan="5"></td>
      <td colspan="4">
        <strong>@Translate("Network usage fee - TOTAL"):</strong>
      </td>
      <td style="text-align: right;">
        <strong>
          @Number(Entity.UsageFeeTotal_EUR) EUR
        </strong>
      </td>
    </tr>
    </tbody>
  </table>
  <p style="margin-top: 1.2rem; margin-left: 0.8rem;">
    <strong>@Translate("B) ELECTRICAL ENERGY SUPPLY FEE")</strong>
  </p>
  <table class="calculation-table" style="margin-top: 0.8rem;">
    <colgroup>
      <col style="width: 15%"/>
      <col style="width: 8%"/>
      <col style="width: 8%"/>
      <col style="width: 9%"/>
      <col style="width: 10%"/>
      <col style="width: 10%"/>
      <col style="width: 5%"/>
      <col style="width: 12%"/>
      <col style="width: 9%"/>
      <col style="width: 8%"/>
    </colgroup>
    <thead>
    <tr class="header">
      <th>@Translate("Device number")</th>
      <th>@Translate("Date from")</th>
      <th>@Translate("Date to")</th>
      <th>@Translate("Tariff item")</th>
      <th>@Translate("Status from")</th>
      <th>@Translate("Status to")</th>
      <th>@Translate("Status")</th>
      <th>@Translate("Usage") (kWh)</th>
      <th>@Translate("Price") (EUR)</th>
      <th>@Translate("Total") (EUR)</th>
    </tr>
    </thead>
    <tbody>
    <tr class="odd">
      <td rowspan="@SupplyRowspan">
        @Entity.MeterId
      </td>
      <td rowspan="@SupplyRowspan">
        @Date(Entity.FromDate)
      </td>
      <td rowspan="@SupplyRowspan">
        @Date(Entity.ToDate)
      </td>
      @(
      Entity.SupplyItems.FirstOrDefault() is { } supplyItem
        ? RenderItem(supplyItem)
        : null)
    </tr>
    @foreach (var item in Entity.SupplyItems.Skip(1))
    {
      <tr>
        @RenderItem(item)
      </tr>
    }
    <tr class="odd">
      <td colspan="4"></td>
      <td colspan="5">
        <strong>@Translate("Supply fee - TOTAL"):</strong>
      </td>
      <td style="text-align: right;">
        <strong>
          @Number(Entity.SupplyFeeTotal_EUR) EUR
        </strong>
      </td>
    </tr>
    </tbody>
  </table>
</div>


@code {

  [Parameter]
  public MeteredNetworkUserCalculationEntity Entity { get; set; } = default!;

  private int UsageRowspan
  {
    get
    {
      var usageItemCount = Entity.UsageItems.Count();
      return usageItemCount == 0 ? 1 : usageItemCount;
    }
  }

  private int SupplyRowspan
  {
    get
    {
      var supplyItemCount = Entity.SupplyItems.Count();
      return supplyItemCount == 0 ? 1 : supplyItemCount;
    }
  }

  private string TariffModelTitle
  {
    get
    {
      return Entity.UsageNetworkUserCatalogue is RedLowNetworkUserCatalogueEntity
        ? Translate("Red NN")
        : Entity.UsageNetworkUserCatalogue is BlueLowNetworkUserCatalogueEntity
          ? Translate("Blue NN")
          : Entity.UsageNetworkUserCatalogue is WhiteLowNetworkUserCatalogueEntity
            ? Translate("White NN")
            : Entity.UsageNetworkUserCatalogue is WhiteMediumNetworkUserCatalogueEntity
              ? Translate("White SN")
              : string.Empty;
    }
  }

  private RenderFragment RenderItem(CalculationItemEntity item) =>
    item is ReactiveEnergyTotalRampedT0CalculationItemEntity reactiveItem
      ? @<Fragment>
          <td>
            <strong class="tariff-label">
              @ItemLabel(reactiveItem)
            </strong>
          </td>
          <td style="padding: 0;">
            <div class="inductive-capacitative-container">
              <p class="inductive-capacitative-label">
                <strong>
                  @Translate("IND"):
                </strong>
                <span>
                  @Number(reactiveItem.ReactiveImportMin_kVARh)
                </span>
              </p>
              <div class="inductive-capacitative-border"/>
              <p class="inductive-capacitative-label">
                <strong>
                  @Translate("KAP"):
                </strong>
                <span>
                  @Number(reactiveItem.ReactiveExportMin_kVARh)
                </span>
              </p>
            </div>
          </td>
          <td style="padding: 0;">
            <div class="inductive-capacitative-container">
              <p class="inductive-capacitative-label">
                <strong>
                  @Translate("IND"):
                </strong>
                <span>
                  @Number(reactiveItem.ReactiveImportMax_kVARh)
                </span>
              </p>
              <div class="inductive-capacitative-border"/>
              <p class="inductive-capacitative-label">
                <strong>
                  @Translate("KAP"):
                </strong>
                <span>
                  @Number(reactiveItem.ReactiveExportMax_kVARh)
                </span>
              </p>
            </div>
          </td>
          <td style="text-align: center;">O</td>
          <td style="text-align: right;">
            @Number(reactiveItem.Amount_kVARh, 0)
          </td>
          <td style="text-align: right;">
            @Number(reactiveItem.Price_EUR, 6)
          </td>
          <td style="text-align: right;">
            @Number(reactiveItem.Total_EUR)
          </td>
        </Fragment>
      : item is ActiveEnergyTotalImportCalculationItemEntity energyItem
        ? @<Fragment>
            <td>
              <strong class="tariff-label">
                @ItemLabel(energyItem)
              </strong>
            </td>
            <td style="text-align: right;">
              @Number(energyItem.Min_kWh)
            </td>
            <td style="text-align: right;">
              @Number(energyItem.Max_kWh)
            </td>
            <td style="text-align: center;">O</td>
            <td style="text-align: right;">
              @Number(energyItem.Amount_kWh, 0)
            </td>
            <td style="text-align: right;">
              @Number(energyItem.Price_EUR, 6)
            </td>
            <td style="text-align: right;">
              @Number(energyItem.Total_EUR)
            </td>
          </Fragment>
        : item is ActivePowerTotalImportT1PeakCalculationItemEntity powerItem
          ? @<Fragment>
              <td>
                <strong class="tariff-label">
                  @ItemLabel(powerItem)
                </strong>
              </td>
              <td style="text-align: right;"></td>
              <td style="text-align: right;"></td>
              <td style="text-align: center;">O</td>
              <td style="text-align: right;">
                @Number(powerItem.Amount_kW, 0)
              </td>
              <td style="text-align: right;">
                @Number(powerItem.Price_EUR, 3)
              </td>
              <td style="text-align: right;">
                @Number(powerItem.Total_EUR)
              </td>
            </Fragment>
          : item is FeeCalculationItemEntity feeItem
            ? @<Fragment>
                <td colspan="4">
                  <strong class="tariff-label">
                    @ItemLabel(feeItem)
                  </strong>
                </td>
                <td style="text-align: right;">
                  @Number(feeItem.Amount_N, 0)
                </td>
                <td style="text-align: right;">
                  @Number(feeItem.Price_EUR, 3)
                </td>
                <td style="text-align: right;">
                  @Number(feeItem.Total_EUR)
                </td>
              </Fragment>
            : throw new InvalidOperationException(
              $"Unsupported item type: {item.GetType()}");

  private string ItemLabel(CalculationItemEntity item) =>
    item switch
    {
      UsageActiveEnergyTotalImportT0CalculationItemEntity => Translate("MJT"),
      UsageActiveEnergyTotalImportT1CalculationItemEntity => Translate("MVT"),
      UsageActiveEnergyTotalImportT2CalculationItemEntity => Translate("MNT"),
      UsageActivePowerTotalImportT1PeakCalculationItemEntity => Translate("SVT"),
      UsageReactiveEnergyTotalRampedT0CalculationItemEntity => Translate("JEN"),
      UsageMeterFeeCalculationItemEntity => Translate("MU"),
      SupplyActiveEnergyTotalImportT1CalculationItemEntity => Translate("RVT"),
      SupplyActiveEnergyTotalImportT2CalculationItemEntity => Translate("RNT"),
      SupplyBusinessUsageCalculationItemEntity => Translate("TRP"),
      SupplyRenewableEnergyCalculationItemEntity => Translate("OIEiK"),
      _ => string.Empty
    };

}
