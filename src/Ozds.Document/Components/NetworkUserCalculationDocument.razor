@namespace Ozds.Document.Components
@using Ozds.Document.Entities
@inherits DocumentBase

<div class="page">
  <div class="page-header">
    @Svg("invoice-print-header-hrv")
  </div>
  <div class="page-content">
    <div class="page-inner-space-between">
      @if (Entity is MeteredNetworkUserCalculationEntity meteredNetworkUserCalculation)
      {
        <MeteredNetworkUserCalculationDocumentContent Entity="@meteredNetworkUserCalculation"/>
      }
      @if (Entity is BlackoutNetworkUserCalculationEntity blackoutNetworkUserCalculation)
      {
        <BlackoutNetworkUserCalculationDocumentContent Entity="@blackoutNetworkUserCalculation"/>
      }
      @if (
        Entity is not BlackoutNetworkUserCalculationEntity
        && (Entity.MeteredFromDate != Entity.FromDate
        || Entity.MeteredToDate != Entity.ToDate))
      {
        <Remark Extended Value="@Entity.Remark">
          <b>
            @string.Format(
              Translate("Data was taken from period: {0} - {1}."),
              DateTime(Entity.MeteredFromDate),
              DateTime(Entity.MeteredToDate))
          </b>
        </Remark>
      }
      else
      {
        <Remark Extended Value="@Entity.Remark"/>
      }
    </div>
  </div>
  <div class="page-footer">
    @Svg("invoice-print-footer-hrv")
  </div>
</div>

<div class="page-break"/>
<div class="page">
  <div class="page-header">
    @Svg("invoice-print-header-hrv")
  </div>
  <div class="page-content">
    <NetworkUserCalculationDocumentAbbreviations/>
  </div>
  <div class="page-footer">
    @Svg("invoice-print-footer-hrv")
  </div>
</div>

@code {

  [Parameter]
  public NetworkUserCalculationEntity Entity { get; set; } = default!;

}
