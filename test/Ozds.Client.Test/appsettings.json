{
  "$schema": "https://json.schemastore.org/appsettings.json",
  "Logging": {
    "LogLevel": {
      "Default": "Information"
    }
  },
  "Ozds": {
    "Client": {
      "Test": {
        "Server": {
          "StatusUri": "http://localhost:5000",
          "Timeout_s": 30,
          "Startup": {
            "Command": "dotnet",
            "Arguments": [
              "run",
              "--project",
              "./src/Ozds.Server/Ozds.Server.csproj"
            ],
            "Environment": {
              "ASPNETCORE_ENVIRONMENT": "Development",
              "DOTNET_ENVIRONMENT": "Development",
              "ASPNETCORE_URLS": "http://localhost:5000"
            },
            "WorkingDirectory": "../../../../../"
          }
        },
        "Browser": {
          "BaseUri": "http://localhost:5000"
        }
      }
    },
    "Data": {
      "UseProxies": false,
      "ConnectionString": "Server=localhost;Port=5432;Database=ozds;User Id=ozds;Password=ozds;Include Error Detail=true"
    },
    "Messaging": {
      "ConnectionString": "Host=localhost;VirtualHost=/;Username=ozds;Password=ozds",
      "PersistenceConnectionString": "Server=localhost;Port=5432;Database=ozds;User Id=ozds;Password=ozds",
      "Endpoints": {
        "AcknowledgeNetworkUserInvoice": "queue:altibiz-network-user-invoice-state-dev"
      },
      "Sagas": {
        "NetworkUserInvoiceState": "ozds-network-user-invoice-state-dev"
      }
    },
    "Email": {
      "Smtp": {
        "Host": "localhost",
        "Port": 1025,
        "Username": "ozds",
        "Password": "ozds",
        "Ssl": false
      },
      "From": {
        "Name": "AltiBiz",
        "Address": "noreply@altibiz.com"
      }
    },
    "Jobs": {
      "ConnectionString": "Server=localhost;Port=5432;Database=ozds;User Id=ozds;Password=ozds"
    }
  }
}
